---
/** One position in full: dates, company, role, every achievement, stack. */
import PlaceholderBadge from "@components/ui/PlaceholderBadge.astro";
import TechBadge from "@components/ui/TechBadge.astro";
import {
  bodyLang,
  employmentLabels,
  renderEntry,
  shortCompany,
  shown,
  shownAll,
  type Position,
} from "@lib/content";
import { formatDuration, formatMonthYear } from "@lib/utils";
import { i18n } from "@/i18n";

interface Props {
  position: Position;
}
const { position } = Astro.props;
const { data } = position;
const { locale, t } = i18n(Astro);
const { Content } = await renderEntry(position);
const lang = bodyLang(position, locale);
const isCurrent = !data.endDate;
// Date range with an en dash: unspaced in English ("Apr 2026–Jun 2026"), spaced in
// Czech, where the range ends are multi-word ("dub 2026 – čen 2026").
const dash = locale === "cs" ? " – " : "–";
const range = `${formatMonthYear(data.startDate, locale)}${dash}${isCurrent ? t("experience.present") : formatMonthYear(data.endDate, locale)}`;
const duration = formatDuration(data.startDate, data.endDate, locale);
const achievements = shownAll(data.achievements);
const meta = [
  employmentLabels[locale][data.employmentType],
  shown(data.workplace),
  shown(data.location),
]
  .filter(Boolean)
  .join(" · ");
---

<article id={position.id} class="grid scroll-mt-24 gap-4 md:grid-cols-[200px_1fr] md:gap-10">
  <div class="mono text-[14px]">
    <p class="font-medium text-accent">{range}</p>
    <p class="mt-1 text-[12px] text-ink-muted">{duration}</p>
  </div>
  <div class="min-w-0">
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
      <div>
        <h3 class="display text-heading">{data.role}</h3>
        <p class="mt-1 text-ink-muted">
          {data.companyUrl ? (
            <a
              href={data.companyUrl}
              class="link-inline font-semibold text-ink"
              rel="noopener noreferrer"
            >
              {shortCompany(data.company)}
            </a>
          ) : (
            <span class="font-semibold text-ink">{shortCompany(data.company)}</span>
          )}
          {meta && <span> · {meta}</span>}
        </p>
      </div>
      {data.placeholder && <PlaceholderBadge />}
    </div>
    <div class="mt-3 max-w-[68ch] text-ink-muted" lang={lang === locale ? undefined : lang}>
      <Content />
    </div>
    {achievements.length > 0 && (
      <ul class="mt-4 max-w-[68ch] list-disc space-y-2 pl-5 marker:text-line-strong">
        {achievements.map((a) => (
          <li>{a}</li>
        ))}
      </ul>
    )}
    {data.technologies.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t("experience.technologies")}>
        {data.technologies.map((tech) => (
          <li>
            <TechBadge label={tech} class="bg-surface" />
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
