---
/** One logbook entry in full: dates, operator, role, every achievement, stack. */
import { render } from "astro:content";
import PlaceholderBadge from "@components/ui/PlaceholderBadge.astro";
import TechBadge from "@components/ui/TechBadge.astro";
import { employmentLabels, shortCompany, shown, shownAll, type Position } from "@lib/content";
import { formatDuration, formatMonthYear } from "@lib/utils";

interface Props {
  position: Position;
}
const { position } = Astro.props;
const { data } = position;
const { Content } = await render(position);
const isCurrent = !data.endDate;
const range = `${formatMonthYear(data.startDate)} — ${isCurrent ? "Present" : formatMonthYear(data.endDate)}`;
const duration = formatDuration(data.startDate, data.endDate);
const achievements = shownAll(data.achievements);
const meta = [employmentLabels[data.employmentType], shown(data.workplace), shown(data.location)]
  .filter(Boolean)
  .join(" · ");
---

<article id={position.id} class="grid scroll-mt-24 gap-4 md:grid-cols-[200px_1fr] md:gap-10">
  <div class="mono text-sm">
    <p class="font-semibold">{range}</p>
    <p class="mt-1 text-xs text-ink-muted uppercase">{duration}</p>
  </div>
  <div class="min-w-0">
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
      <div>
        <h3 class="text-heading font-bold">{data.role}</h3>
        <p class="mt-1 text-ink-muted">
          {data.companyUrl ? (
            <a
              href={data.companyUrl}
              class="link-inline font-semibold text-ink"
              rel="noopener noreferrer"
            >
              {shortCompany(data.company)}
            </a>
          ) : (
            <span class="font-semibold text-ink">{shortCompany(data.company)}</span>
          )}
          {meta && <span> · {meta}</span>}
        </p>
      </div>
      {data.placeholder && <PlaceholderBadge />}
    </div>
    <div class="mt-3 max-w-[68ch] text-ink-muted">
      <Content />
    </div>
    {achievements.length > 0 && (
      <ul class="mt-4 flex max-w-[68ch] flex-col gap-2">
        {achievements.map((a) => (
          <li class="flex gap-3">
            <span class="mono mt-[0.15em] shrink-0 text-xs text-ok-ink" aria-hidden="true">
              ✓
            </span>
            <span>{a}</span>
          </li>
        ))}
      </ul>
    )}
    {data.technologies.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
        {data.technologies.map((t) => (
          <li>
            <TechBadge label={t} />
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
