---
/** Education, certifications, talks, awards or community work — one group. */
import { milestoneLabels, shown, type Milestone } from "@lib/content";
import { formatMonthYear } from "@lib/utils";

interface Props {
  type: Milestone["data"]["type"];
  items: Milestone[];
}
const { type, items } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby={`milestone-${type}`} class="card p-6">
    <h3 id={`milestone-${type}`} class="label text-ink-muted">
      {milestoneLabels[type].plural}
    </h3>
    <ul class="mt-4 divide-y divide-line">
      {items.map(({ data }) => (
        <li class="py-3 first:pt-0 last:pb-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <p class="font-semibold">
              {data.url ? (
                <a href={data.url} class="link-inline" rel="noopener noreferrer">
                  {data.title}
                </a>
              ) : (
                data.title
              )}
            </p>
            <p class="meta text-ink-muted">
              {formatMonthYear(data.date)}
              {data.endDate && ` — ${formatMonthYear(data.endDate)}`}
            </p>
          </div>
          {(shown(data.organization) || shown(data.location)) && (
            <p class="mt-0.5 text-small text-ink-muted">
              {[shown(data.organization), shown(data.location)].filter(Boolean).join(" · ")}
            </p>
          )}
          {shown(data.description) && (
            <p class="mt-1 text-small text-ink-muted">{data.description}</p>
          )}
        </li>
      ))}
    </ul>
  </section>
)}
