---
/**
 * SiteHeader — sticky header from the approved artboard: cube mark + name, nav
 * (Products · Capabilities · Cases · Experience · About), availability pill, theme
 * toggle, EN | CS switch and the Contact button. Below 1024px the nav and Contact collapse into a 44px menu
 * button that opens a full-height sheet with every route (native <dialog>: focus
 * trapping, Escape and an inert page for free). A 1px line appears once scrolled.
 */
import LogoMark from "@components/ui/LogoMark.astro";
import StatusPill from "@components/ui/StatusPill.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import LanguageSwitch from "@components/ui/LanguageSwitch.astro";
import { navigation, primaryNav, siteConfig, withWriting } from "@config";
import { contactRoutes } from "@data/contact";
import { hasWriting } from "@lib/content";
import { cleanPath } from "@lib/utils";
import { i18n, stripLocale, type Locale } from "@/i18n";

interface Props {
  /** Language-switch targets when they differ from "this page in the other language". */
  langPaths?: Partial<Record<Locale, string>>;
}
const { langPaths } = Astro.props;
const { locale, t, l } = i18n(Astro);

// Writing joins the menu sheet once a post is published.
const sheetNav = withWriting(navigation, await hasWriting());

// Active states compare the path without its /cs prefix against the English hrefs.
const pathname = stripLocale(cleanPath(Astro.url.pathname));
const isActive = (match?: string) =>
  match ? pathname === match || pathname.startsWith(`${match}/`) : false;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header pt-safe sticky top-0 z-40" data-site-header>
  <div class="band py-[18px]">
    <div class="shell flex items-center justify-between gap-6">
      <a
        href={l("/")}
        class="inline-flex min-h-11 shrink-0 items-center gap-2.5 text-[20px] font-extrabold tracking-[-0.02em] no-underline hover:text-ink"
      >
        <LogoMark />
        {siteConfig.name}
      </a>

      <nav aria-label={t("nav.main")} class="max-nav:hidden">
        <ul class="flex items-center gap-7 text-[15px] font-medium">
          {primaryNav.map((item) => {
            const active = isActive(item.match);
            return (
              <li>
                <a
                  href={l(item.href)}
                  aria-current={active ? "page" : undefined}
                  class:list={["nav-link", active && "nav-link--active"]}
                >
                  {t(item.key)}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="flex items-center gap-2.5">
        {/* The pill needs ≥ 1240px beside the nav and EN | CS; the profile card repeats it. */}
        <StatusPill class="max-[1239px]:hidden" />
        <LanguageSwitch class="max-[520px]:hidden" paths={langPaths} />
        <ThemeToggle />
        <a href={l("/contact")} class="btn btn-ink btn-sm max-nav:hidden">
          {t("nav.contact")}
        </a>
        <button
          type="button"
          class="icon-btn nav:hidden"
          aria-label={t("menu.open")}
          aria-haspopup="dialog"
          aria-controls="site-menu"
          aria-expanded="false"
          data-open-menu
        >
          <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true">
            <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <dialog
    id="site-menu"
    class="m-0 h-dvh max-h-none w-full max-w-none bg-bg p-0 text-ink backdrop:bg-black/40 open:flex open:flex-col nav:hidden"
    aria-label={t("menu.label")}
  >
    <div class="band pt-safe shrink-0 border-b border-line">
      <div class="flex items-center justify-between gap-4 py-[18px]">
        <span class="inline-flex min-h-11 items-center gap-2.5 text-[20px] font-extrabold tracking-[-0.02em]">
          <LogoMark />
          {siteConfig.name}
        </span>
        <button type="button" class="icon-btn" aria-label={t("menu.close")} data-close-menu>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
        </button>
      </div>
    </div>
    <nav aria-label={t("menu.pages")} class="band flex-1 overflow-y-auto py-6">
      <ol class="flex flex-col">
        {sheetNav.map((item) => {
          const current = isCurrent(item.href);
          return (
            <li>
              <a
                href={l(item.href)}
                aria-current={current ? "page" : undefined}
                class:list={[
                  "flex min-h-[52px] items-center justify-between border-b border-line py-3 text-[22px] font-bold tracking-[-0.01em] no-underline",
                  current && "text-accent",
                ]}
              >
                <span>{t(item.key)}</span>
              </a>
            </li>
          );
        })}
      </ol>
      <p class="label mt-8 text-ink-muted">{t("menu.getInTouch")}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {contactRoutes(locale).map((r) => (
          <li>
            <a href={l(`/contact?topic=${r.id}`)} class="chip">
              {r.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8">
        <a href={`mailto:${siteConfig.email}`} class="link-inline font-semibold break-all">
          {siteConfig.email}
        </a>
      </p>
      <div class="mt-8 flex items-center gap-3">
        <span class="label text-ink-muted">{t("lang.label")}</span>
        <LanguageSwitch paths={langPaths} />
      </div>
    </nav>
  </dialog>
</header>

<style>
  .site-header {
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .nav-link:hover {
    color: var(--accent);
  }
  .nav-link--active {
    color: var(--accent);
    text-decoration-line: underline;
  }
</style>

<script>
  function setupHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (header && !header.dataset.bound) {
      header.dataset.bound = "true";
      const onScroll = () => {
        if (window.scrollY > 4) header.dataset.scrolled = "";
        else delete header.dataset.scrolled;
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      document.addEventListener(
        "astro:before-swap",
        () => window.removeEventListener("scroll", onScroll),
        { once: true },
      );
    }

    const dialog = document.getElementById("site-menu") as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = "true";
    const close = () => dialog.open && dialog.close();
    const openers = document.querySelectorAll<HTMLElement>("[data-open-menu]");
    openers.forEach((b) =>
      b.addEventListener("click", () => {
        dialog.showModal();
        openers.forEach((o) => o.setAttribute("aria-expanded", "true"));
        document.documentElement.style.overflow = "hidden";
      }),
    );
    dialog.querySelectorAll("[data-close-menu]").forEach((b) => b.addEventListener("click", close));
    dialog.addEventListener("close", () => {
      openers.forEach((o) => o.setAttribute("aria-expanded", "false"));
      document.documentElement.style.overflow = "";
    });
    dialog.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
      if (e.matches) close();
    });
  }
  document.addEventListener("astro:page-load", setupHeader);
  document.addEventListener("astro:before-preparation", () => {
    const dialog = document.getElementById("site-menu") as HTMLDialogElement | null;
    if (dialog?.open) dialog.close();
  });
</script>
