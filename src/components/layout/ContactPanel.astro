---
/**
 * The accent contact panel that closes every page (approved artboard): "Ready to
 * ship your project.", one line on what I take on, three route columns (Hiring /
 * Investing / Contract work) set directly on the accent fill between thin on-accent
 * rules, the email as a button, Copy, LinkedIn, GitHub and the CV. Inside a page the routes open /contact with the topic
 * preselected; on /contact itself (`level={1}`) they are emails with the subject
 * filled in.
 */
import ContactRoute from "@components/contact/ContactRoute.astro";
import CopyEmail from "@components/ui/CopyEmail.astro";
import CvLink from "@components/ui/CvLink.astro";
import { siteConfig } from "@config";
import { contactRoutes, mailtoFor, type ContactRoute as Route } from "@data/contact";
import { i18n } from "@/i18n";

interface Props {
  /** Heading level: 2 inside a page, 1 when the panel is the page head (/contact). */
  level?: 1 | 2;
}
const { level = 2 } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
const { locale, t, l } = i18n(Astro);
const routes = contactRoutes(locale);
const routeHref = (route: Route) =>
  level === 1 ? mailtoFor(siteConfig.email, route.subject) : l(`/contact?topic=${route.id}`);
---

<section
  id="contact"
  class:list={["band pb-14", level === 1 && "pt-6"]}
  aria-labelledby="contact-heading"
>
  <div class="contact-panel shell flex flex-col gap-10 rounded-lg bg-accent p-[clamp(20px,5vw,72px)] text-on-accent">
    <div class="flex flex-col gap-3.5">
      <span class="label">{t("contact.eyebrow")}</span>
      <Heading id="contact-heading" class="display text-display-panel">
        {t("contact.title1")}
        <br />
        {t("contact.title2")}
      </Heading>
      <p class="max-w-[620px] text-body-l">{t("contact.intro")}</p>
    </div>
    <ul class="routes grid lg:grid-cols-3">
      {routes.map((route) => (
        <li class="flex">
          <ContactRoute route={route} href={routeHref(route)} level={level === 1 ? 2 : 3} />
        </li>
      ))}
    </ul>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href={`mailto:${siteConfig.email}`}
        class="email-btn inline-flex min-h-[54px] max-w-full items-center rounded-sm bg-surface px-5 text-[clamp(15px,1.2vw,17px)] font-bold text-accent no-underline"
      >
        <span class="truncate">{siteConfig.email}</span>
      </a>
      <CopyEmail tone="accent" />
      {siteConfig.social.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          class="link-inline inline-flex min-h-11 items-center underline-offset-[6px]"
          rel="me"
        >
          LinkedIn
        </a>
      )}
      {siteConfig.social.github && (
        <a
          href={siteConfig.social.github}
          class="link-inline inline-flex min-h-11 items-center underline-offset-[6px]"
          rel="me"
        >
          GitHub
        </a>
      )}
      <CvLink class="link-inline inline-flex min-h-11 items-center underline-offset-[6px]" />
    </div>
  </div>
</section>

<style>
  /* Focus rings switch to the on-accent colour on the accent fill. */
  .contact-panel {
    --focus: var(--on-accent);
    --rule-on-accent: color-mix(in srgb, var(--on-accent) 30%, transparent);
  }
  .contact-panel a:hover {
    color: var(--on-accent);
  }
  .email-btn:hover {
    color: var(--accent-hover) !important;
  }
  /* Route columns: rules above, between and below; stacked rows on narrow screens,
     three columns with vertical rules from 1024px. */
  .routes {
    border-block: 1px solid var(--rule-on-accent);
  }
  .routes > li + li {
    border-top: 1px solid var(--rule-on-accent);
  }
  @media (min-width: 64rem) {
    .routes > li + li {
      border-top: 0;
      border-left: 1px solid var(--rule-on-accent);
    }
  }
</style>
