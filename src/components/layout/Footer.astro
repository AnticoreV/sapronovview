---
/**
 * Footer on the night panel: pages, contact routes, channels, RSS + sitemap,
 * and the © / ALL SYSTEMS NORMAL strip.
 */
import { navigation, siteConfig, withWriting } from "@config";
import { contactRoutes } from "@data/contact";
import { hasWriting } from "@lib/content";

// RSS and Writing appear once there is something to read.
const hasPosts = await hasWriting();
const pages = withWriting(navigation, hasPosts);

const year = new Date().getFullYear();
const channels = [
  { label: siteConfig.email, href: `mailto:${siteConfig.email}` },
  siteConfig.social.linkedin && { label: "LinkedIn", href: siteConfig.social.linkedin },
  siteConfig.social.github && { label: "GitHub", href: siteConfig.social.github },
  hasPosts && { label: "RSS", href: "/rss.xml" },
  { label: "Sitemap", href: "/sitemap-index.xml" },
].filter(Boolean) as Array<{ label: string; href: string }>;
---

<footer class="night bg-panel text-ink-muted">
  <div class="band border-t border-panel-edge py-12">
    <div class="shell grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
      <nav aria-label="Footer">
        <p class="label text-xs text-ink-muted">Pages</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1 text-small">
          {pages.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-8 items-center text-ink hover:underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div>
        <p class="label text-xs text-ink-muted">Routes</p>
        <ul class="mt-3 grid gap-y-1 text-small">
          {contactRoutes.map((r) => (
            <li>
              <a
                href={`/contact?topic=${r.id}`}
                class="inline-flex min-h-8 items-center text-ink hover:underline"
              >
                {r.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="label text-xs text-ink-muted">Channels</p>
        <ul class="mt-3 grid gap-y-1 text-small">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                class="inline-flex min-h-8 items-center break-all text-ink hover:underline"
                {...(c.href.startsWith("http") ? { rel: "me" } : {})}
              >
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="band mono pb-safe-18 flex flex-wrap justify-between gap-3 border-t border-panel-edge pt-[18px] text-xs">
    <span>
      © {year} {siteConfig.name.toUpperCase()}
    </span>
    <span>ALL SYSTEMS NORMAL</span>
  </div>
</footer>
