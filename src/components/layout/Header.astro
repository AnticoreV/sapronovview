---
/**
 * HeaderStrip — the site header as a dark instrument strip: callsign, mono nav
 * (current page in cyan, underlined), the availability annunciator and the day /
 * night knob. Below 960px the nav moves into a full-height face sheet (native
 * <dialog>: focus trapping, Escape and inert page for free).
 */
import Annunciator from "@components/ui/Annunciator.astro";
import ThemeKnob from "@components/ui/ThemeKnob.astro";
import { navigation, primaryNav, siteConfig } from "@config";
import { contactRoutes } from "@data/contact";
import { cleanPath } from "@lib/utils";

const pathname = cleanPath(Astro.url.pathname);
const isActive = (match?: string) =>
  match ? pathname === match || pathname.startsWith(`${match}/`) : false;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="face-band sticky top-0 z-40" style="padding-top: env(safe-area-inset-top)">
  <div class="band flex min-h-[64px] items-center justify-between gap-6 py-2.5">
    <a
      href="/"
      class="mono shrink-0 text-[13px] font-semibold tracking-[0.1em] text-marking no-underline sm:text-sm"
    >
      {siteConfig.callsign}
      <span class="max-sm:hidden"> / {siteConfig.base}</span>
      <span class="sr-only">— {siteConfig.name}, home</span>
    </a>

    <nav aria-label="Primary" class="max-nav:hidden">
      <ul class="mono flex items-center gap-[26px] text-[13px]">
        {primaryNav.map((item) => {
          const active = isActive("match" in item ? item.match : undefined);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "nav-link uppercase",
                  active ? "text-select underline" : "text-marking no-underline",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <span transition:persist="annunciator">
        <Annunciator blink />
      </span>
      <ThemeKnob />
      <button
        type="button"
        class="nav:hidden inline-flex size-11 items-center justify-center rounded-sm border border-[#464c49] bg-transparent text-marking"
        aria-label="Open menu"
        aria-haspopup="dialog"
        aria-controls="mobile-nav"
        data-open-menu
      >
        <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true">
          <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <dialog
    id="mobile-nav"
    class="face-band m-0 h-dvh max-h-none w-full max-w-none p-0 backdrop:bg-black/50 open:flex open:flex-col nav:hidden"
    aria-label="Site navigation"
  >
    <div
      class="band flex min-h-[64px] shrink-0 items-center justify-between gap-4 border-b border-[#2a2f2e] py-2.5"
      style="padding-top: max(10px, env(safe-area-inset-top))"
    >
      <span class="mono text-[13px] font-semibold tracking-[0.1em]">{siteConfig.callsign}</span>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-sm border border-[#464c49] bg-transparent text-marking"
        aria-label="Close menu"
        data-close-menu
      >
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Mobile" class="band flex-1 overflow-y-auto py-6">
      <ol class="flex flex-col">
        {navigation.map((item, i) => {
          const current = isCurrent(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={current ? "page" : undefined}
                class:list={[
                  "flex min-h-[52px] items-center justify-between border-b border-[#2a2f2e] py-3 text-[22px] font-bold no-underline",
                  current ? "text-select" : "text-marking",
                ]}
              >
                <span>{item.label}</span>
                <span class="mono text-xs font-semibold text-marking-muted" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
      <p class="label mt-8 text-marking-muted">Routes</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {contactRoutes.map((r) => (
          <li>
            <a
              href={`/contact?topic=${r.id}`}
              class="mono inline-flex min-h-11 items-center rounded-sm border border-[#464c49] px-3 text-xs font-semibold tracking-[0.04em] text-marking uppercase no-underline"
            >
              {r.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8">
        <a href={`mailto:${siteConfig.email}`} class="link-inline break-all text-marking">
          {siteConfig.email}
        </a>
      </p>
    </nav>
  </dialog>
</header>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .nav-link:hover {
    text-decoration-line: underline;
  }
</style>

<script>
  function setupMobileNav() {
    const dialog = document.getElementById("mobile-nav") as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = "true";

    const close = () => dialog.open && dialog.close();
    document.querySelectorAll("[data-open-menu]").forEach((b) =>
      b.addEventListener("click", () => {
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
      }),
    );
    dialog.querySelectorAll("[data-close-menu]").forEach((b) => b.addEventListener("click", close));
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });
    dialog.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    window.matchMedia("(min-width: 60rem)").addEventListener("change", (e) => {
      if (e.matches) close();
    });
  }
  document.addEventListener("astro:page-load", setupMobileNav);
  document.addEventListener("astro:before-preparation", () => {
    const dialog = document.getElementById("mobile-nav") as HTMLDialogElement | null;
    if (dialog?.open) dialog.close();
  });
</script>
