---
/**
 * ContactRoute — one audience route into contact, on the night panel.
 * Hover / focus: a 2px cyan inset ring.
 */
interface Props {
  route: { id: string; label: string; title: string; text: string };
  href: string;
  /** Heading level of the route title. */
  level?: 2 | 3;
}
const { route, href, level = 3 } = Astro.props;
const Title = level === 2 ? "h2" : "h3";
---

<a
  href={href}
  class="route flex w-full flex-col gap-2 rounded-lg bg-panel-raised p-7 text-ink no-underline"
>
  <span class="label text-xs text-select">{route.label}</span>
  <Title class="text-title font-bold">{route.title}</Title>
  <span class="text-small text-ink-muted">{route.text}</span>
</a>

<style>
  .route {
    box-shadow: inset 0 0 0 1px var(--panel-edge);
    transition: box-shadow 0.15s ease;
  }
  .route:hover,
  .route:focus-visible {
    box-shadow: inset 0 0 0 2px var(--select);
  }
</style>
