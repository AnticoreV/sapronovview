---
/**
 * ContactRoute: one audience route into contact (Hiring / Investing / Partnering), a
 * column set directly on the accent contact panel in on-accent text. The whole column
 * is the link; hover and focus underline the title, focus also draws the ring.
 */
interface Props {
  route: { id: string; label: string; title: string; text: string };
  href: string;
  /** Heading level of the route title. */
  level?: 2 | 3;
}
const { route, href, level = 3 } = Astro.props;
const Title = level === 2 ? "h2" : "h3";
---

<a href={href} class="route flex w-full flex-col gap-2 py-6 text-on-accent no-underline">
  <span class="mono text-[13px] font-medium">{route.label}</span>
  <Title class="route__title text-[21px] leading-[1.25] font-bold">{route.title}</Title>
  <span class="text-small text-on-accent/90">{route.text}</span>
</a>

<style>
  .route:hover {
    color: var(--on-accent);
  }
  .route__title {
    text-decoration-line: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .route:hover .route__title,
  .route:focus-visible .route__title {
    text-decoration-line: underline;
  }
  .route:focus-visible {
    outline: 2px solid var(--on-accent);
    outline-offset: 4px;
  }
  /* Side by side from 1024px: inner padding beside the vertical rules. */
  @media (min-width: 64rem) {
    .route {
      padding-inline: 28px;
    }
    :global(li:first-child) > .route {
      padding-left: 0;
    }
    :global(li:last-child) > .route {
      padding-right: 0;
    }
  }
</style>
