---
/**
 * All <head> metadata: title, description, canonical, Open Graph, Twitter
 * cards, RSS discovery, and Person / WebSite structured data.
 */
import JsonLd from "@components/seo/JsonLd.astro";
import { siteConfig, siteCopy } from "@config";
import { hasWriting } from "@lib/content";
import { personSchema } from "@lib/schema";
import { cleanPath } from "@lib/utils";
import { i18n, localizePath, locales, stripLocale } from "@/i18n";
import { localeTags, ogLocales } from "@/i18n/locales";

export interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL of the social image. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  /** Set to true to prevent indexing (e.g. drafts). */
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Override the canonical URL (defaults to the current page). */
  canonical?: string;
  /** Skip the site-name suffix (used on the homepage). */
  titleTemplate?: boolean;
}

const { locale } = i18n(Astro);
const copy = siteCopy[locale];

const {
  title,
  description = copy.description,
  image = locale === "cs" ? siteConfig.ogImageCs : siteConfig.ogImage,
  imageAlt = `${siteConfig.name} — ${copy.title}`,
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  tags = [],
  canonical,
  titleTemplate = true,
} = Astro.props;

const site = Astro.site ?? new URL("http://localhost:4321");
const pathname = cleanPath(Astro.url.pathname);
const canonicalUrl = canonical ?? new URL(pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const fullTitle = titleTemplate ? `${title} · ${siteConfig.name}` : title;

// The same page in every language: hreflang alternates (x-default = English).
const basePath = stripLocale(pathname);
const alternates = locales.map((code) => ({
  hreflang: code,
  href: new URL(localizePath(basePath, code), site).toString(),
}));
const otherLocales = locales.filter((code) => code !== locale);

const isHome = basePath === "/";
const hasPosts = await hasWriting();
const [firstName, ...lastNames] = siteConfig.name.split(" ");

const personLd = { "@context": "https://schema.org", ...personSchema(site) };

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.origin}/#website`,
  name: siteConfig.name,
  url: site.origin,
  description: copy.description,
  inLanguage: localeTags[locale],
  publisher: { "@id": `${site.origin}/#person` },
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* No canonical on noindex pages (404, empty /writing). */}
{!noindex && <link rel="canonical" href={canonicalUrl} />}
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
<meta name="author" content={siteConfig.name} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large" />
)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={ogLocales[locale]} />
{otherLocales.map((code) => (
  <meta property="og:locale:alternate" content={ogLocales[code]} />
))}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === "article" && <meta property="article:author" content={siteConfig.name} />}
{isHome && type === "profile" && (
  <>
    <meta property="profile:first_name" content={firstName} />
    <meta property="profile:last_name" content={lastNames.join(" ")} />
  </>
)}
{tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{siteConfig.twitterHandle && <meta name="twitter:creator" content={siteConfig.twitterHandle} />}
{siteConfig.twitterHandle && <meta name="twitter:site" content={siteConfig.twitterHandle} />}

{hasPosts && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${siteConfig.name} — Writing`}
    href={new URL("/rss.xml", site).toString()}
  />
)}
<link rel="sitemap" href="/sitemap-index.xml" />

{isHome && <JsonLd data={personLd} />}
{isHome && <JsonLd data={websiteLd} />}
