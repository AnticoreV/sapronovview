---
/**
 * Section title row from the artboard: display heading left, a mono placard or a
 * ghost link ("ALL PROJECTS →") right.
 */
interface Props {
  id?: string;
  title: string;
  /** Mono placard on the right (e.g. "WHAT I CAN DO FOR YOU"). */
  tag?: string;
  /** Ghost link on the right instead of the placard. */
  href?: string;
  linkLabel?: string;
  level?: 1 | 2;
  class?: string;
}
const { id, title, tag, href, linkLabel, level = 2, class: className } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
---

<div class:list={["flex flex-wrap items-end justify-between gap-4", className]}>
  <Heading id={id} class="display text-display-l">
    {title}
  </Heading>
  {href ? (
    <a href={href} class="link-ghost inline-flex min-h-11 items-center">
      {linkLabel} <span aria-hidden="true">&nbsp;→</span>
    </a>
  ) : (
    tag && <span class="label font-normal text-ink-muted">{tag}</span>
  )}
  <slot name="action" />
</div>
