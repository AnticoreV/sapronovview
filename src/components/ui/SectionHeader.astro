---
/**
 * Section title row from the artboard: a 1px ink rule, the display-l heading, and an
 * action on the right when there is one (a text link, or any element in the
 * "action" slot). Nothing decorative sits beside the heading.
 */
interface Props {
  id?: string;
  title: string;
  /** Text link on the right ("All projects"). */
  href?: string;
  linkLabel?: string;
  level?: 1 | 2;
  class?: string;
}
const { id, title, href, linkLabel, level = 2, class: className } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
---

<div class:list={["section-head", className]}>
  <Heading id={id} class="display text-display-l">
    {title}
  </Heading>
  {href && (
    <a href={href} class="link-more">
      {linkLabel}
    </a>
  )}
  <slot name="action" />
</div>
