---
/**
 * Dev-only marker for content that still contains placeholders. Production
 * builds never render placeholder entries, so this never ships.
 */
interface Props {
  label?: string;
}
const { label = "Placeholder" } = Astro.props;
---

{import.meta.env.DEV && (
  <span class="mono inline-flex items-center rounded-sm border border-dashed border-ink-muted px-1.5 py-0.5 text-[11px] font-semibold tracking-[0.04em] text-ink-muted uppercase">
    [{label}]
  </span>
)}
