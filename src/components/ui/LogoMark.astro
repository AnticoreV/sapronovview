---
/** The 3-face isometric cube from the approved artboard (decorative). */
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 26 26"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path d="M13 2 23 7.5 13 13 3 7.5Z" class="iso-blue"></path>
  <path d="M3 7.5 13 13v11L3 18.5Z" class="iso-blue-l"></path>
  <path d="M23 7.5 13 13v11l10-5.5Z" class="iso-blue-r"></path>
</svg>
