---
/**
 * Readout — an LCD on an instrument face: a mono label naming the source
 * ("USERS · NCR VOYIX") above a cyan value. Only real, sourced numbers.
 * Values with `count` count up once when first seen (static under reduced motion).
 */
import type { Readout } from "@data/readouts";

interface Props {
  readout: Readout;
  size?: "md" | "lg";
  class?: string;
}
const { readout, size = "md", class: className } = Astro.props;
const count = readout.count;
---

<div
  class:list={[
    "face flex flex-col justify-between gap-2.5 rounded-lg px-[18px] py-4 shadow-[inset_0_0_0_4px_var(--face-edge)]",
    className,
  ]}
>
  <span class="mono text-[11px] font-semibold tracking-[0.04em] text-marking-muted uppercase">
    {readout.label} · {readout.source}
  </span>
  <span
    class:list={[
      "mono tabular leading-none font-bold text-select",
      size === "lg" ? "text-readout" : "text-[clamp(1.625rem,3vw,2.125rem)]",
    ]}
    data-count-to={count?.to}
    data-count-prefix={count?.prefix}
    data-count-suffix={count?.suffix}
  >
    {readout.value}
  </span>
  <span class="sr-only">— {readout.detail}</span>
</div>

<script>
  /** Count numeric readouts up once when first seen (600 ms). Static under reduced motion. */
  function setupCountUp() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const els = [...document.querySelectorAll<HTMLElement>("[data-count-to]:not([data-counted])")];
    if (!els.length || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          const to = Number(el.dataset.countTo);
          const prefix = el.dataset.countPrefix ?? "";
          const suffix = el.dataset.countSuffix ?? "";
          const final = el.textContent ?? "";
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min(1, (now - start) / 600);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = t < 1 ? `${prefix}${Math.round(to * eased)}${suffix}` : final;
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.6 },
    );
    for (const el of els) {
      el.dataset.counted = "";
      io.observe(el);
    }
  }
  document.addEventListener("astro:page-load", setupCountUp);
</script>
