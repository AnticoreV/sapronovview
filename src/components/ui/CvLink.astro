---
/**
 * The CV link: "Download CV" once the PDF exists in public/ (src/lib/cv.ts), otherwise
 * "CV on request", which opens /contact with the hiring topic (or, with `mailto`, an email
 * with the subject filled in: on /contact itself). Used in the hero, the experience
 * section and the contact panel.
 */
import { siteConfig } from "@config";
import { mailtoFor } from "@data/contact";
import { cvPath } from "@lib/cv";
import { i18n } from "@/i18n";

interface Props {
  class?: string;
  /** Ask by email instead of linking to /contact. */
  mailto?: boolean;
}
const { class: className, mailto = false } = Astro.props;
const { t, l } = i18n(Astro);
const requestHref = mailto
  ? mailtoFor(siteConfig.email, t("record.cvRequest"))
  : l("/contact?topic=hiring");
---

{cvPath ? (
  <a href={cvPath} class={className} download>
    {t("record.cvDownload")}
  </a>
) : (
  <a href={requestHref} class={className}>
    {t("record.cvRequest")}
  </a>
)}
