---
/**
 * Availability annunciator: a lit capsule in the avionics code. Reads
 * `siteConfig.availability` (open → OPEN TO PROJECTS, limited, closed). The state
 * is always written out; colour is never the only signal. Blinks twice on load
 * (no blink under reduced motion).
 */
import { availabilityText, siteConfig } from "@config";

interface Props {
  /** "auto" shows the short word on narrow screens, "long" always the full text. */
  length?: "auto" | "long";
  /** Blink twice on first paint. */
  blink?: boolean;
  class?: string;
}
const { length = "auto", blink = false, class: className } = Astro.props;
const status = siteConfig.availability.status;
const text = availabilityText[status];
---

<span
  class:list={["annunciator", `annunciator--${status}`, blink && "annunciator--blink", className]}
>
  <span class="sr-only">Availability: </span>
  {length === "auto" ? (
    <>
      <span class="max-sm:hidden">{text.long}</span>
      <span class="sm:hidden" aria-hidden="true">
        {text.short}
      </span>
    </>
  ) : (
    text.long
  )}
</span>

<style>
  .annunciator {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .annunciator--open {
    background: var(--ok-annunciator);
    color: var(--ok);
    box-shadow: var(--shadow-glow-ok);
  }
  .annunciator--limited {
    background: #2a2208;
    color: var(--caution);
  }
  .annunciator--closed {
    background: var(--face-edge);
    color: var(--marking-muted);
  }
  .annunciator--blink {
    animation: annunciator-blink 0.5s steps(1, end) 0.35s 2;
  }
</style>
