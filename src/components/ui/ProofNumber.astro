---
/**
 * ProofNumber: a big numeral (Schibsted 800, tabular), then a mono caption saying what
 * is measured and, on its own line, where it comes from. Only real, sourced numbers
 * from src/data/readouts.ts, rendered as they are (no count-up).
 */
import Glyphs from "@components/ui/Glyphs.astro";
import type { Readout } from "@data/readouts";

interface Props {
  readout: Readout;
  /** "lg" = homepage proof row (numeral scale), "md" = case studies. */
  size?: "md" | "lg";
  class?: string;
}
const { readout, size = "lg", class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-2", className]}>
  <span
    class:list={[
      "display tabular leading-none tracking-[-0.04em]",
      size === "lg" ? "text-numeral" : "text-[clamp(36px,4vw,48px)]",
    ]}
    aria-hidden={readout.spoken ? "true" : undefined}
  >
    <Glyphs text={readout.value} weight="heavy" silent={Boolean(readout.spoken)} />
  </span>
  {readout.spoken && <span class="sr-only">{readout.spoken}</span>}
  <span class="mono flex flex-col text-[12px] font-medium">
    <span>{readout.label}</span>
    <span class="text-ink-muted">{readout.source}</span>
  </span>
  <span class="sr-only">{readout.detail}</span>
</div>
