---
/**
 * Light / dark toggle. The active theme is stored in localStorage and applied
 * before first paint by the inline script in BaseLayout, so there is no flash.
 */
import { Moon, Sun } from "lucide-astro";
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "text-fg-muted hover:bg-surface-muted hover:text-fg relative inline-flex size-10 items-center justify-center rounded-pill transition-colors",
    className,
  ]}
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <Sun
    size={18}
    aria-hidden="true"
    class="absolute scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90"
  />
  <Moon
    size={18}
    aria-hidden="true"
    class="absolute scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0"
  />
</button>

<script>
  function setupThemeToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
    const sync = () => {
      const isDark = document.documentElement.classList.contains("dark");
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(isDark)));
    };
    buttons.forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "true";
      button.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {
          /* storage unavailable */
        }
        sync();
      });
    });
    sync();
  }
  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
