---
/**
 * Day / night panel rotary knob. Rotates 70° in one detented step, stores the
 * choice in localStorage (the inline script in BaseLayout applies it before
 * paint) and defaults to the OS preference. A toggle button: "Night panel",
 * pressed = night.
 */
---

<button
  type="button"
  class="knob"
  data-theme-knob
  aria-label="Night panel"
  aria-pressed="false"
  title="Day / night panel"
>
  <span class="knob__dial" aria-hidden="true">
    <i class="knob__pointer"></i>
  </span>
</button>

<style>
  .knob {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }
  .knob__dial {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 2px solid #464c49;
    background: #1c201f;
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.4);
  }
  .knob:hover .knob__dial {
    border-color: #a2a8a4;
  }
  .knob__pointer {
    width: 3px;
    height: 12px;
    border-radius: 1px;
    background: var(--marking);
    transform: translateY(-4px) rotate(-35deg);
    transform-origin: 50% 100%;
    transition: transform 0.2s steps(2, end);
  }
  :global(.dark) .knob__pointer {
    transform: translateY(-4px) rotate(35deg);
    background: var(--select);
  }
</style>

<script>
  function setupThemeKnob() {
    const knobs = document.querySelectorAll<HTMLButtonElement>("[data-theme-knob]");
    const sync = () => {
      const night = document.documentElement.classList.contains("dark");
      knobs.forEach((k) => k.setAttribute("aria-pressed", String(night)));
    };
    knobs.forEach((knob) => {
      if (knob.dataset.bound) return;
      knob.dataset.bound = "true";
      knob.addEventListener("click", () => {
        const night = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", night ? "dark" : "light");
        } catch {
          /* storage unavailable — the choice lasts for this page only */
        }
        sync();
        document.dispatchEvent(new CustomEvent("themechange", { detail: { night } }));
      });
    });
    sync();
  }
  document.addEventListener("astro:page-load", setupThemeKnob);
</script>
