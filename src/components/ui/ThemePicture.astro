---
/**
 * One <picture> with a light and a dark image. Dark sources match
 * `(prefers-color-scheme: dark)`, which is also the default theme, so the browser
 * downloads only the image it shows. When the stored theme overrides the OS (or the
 * header toggle is used), a tiny script re-targets the sources to the `.dark` class.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto";
  class?: string;
}
const {
  light,
  dark,
  alt,
  widths,
  sizes,
  loading = "lazy",
  fetchpriority,
  class: className,
} = Astro.props;

const variant = async (src: ImageMetadata, format: "avif" | "webp") =>
  getImage({ src, widths: widths.filter((w) => w <= src.width), format });
const [lightAvif, lightWebp, darkAvif, darkWebp] = await Promise.all([
  variant(light, "avif"),
  variant(light, "webp"),
  variant(dark, "avif"),
  variant(dark, "webp"),
]);
const DARK = "(prefers-color-scheme: dark)";
---

<picture data-theme-picture>
  <source
    data-theme-source="dark"
    media={DARK}
    type="image/avif"
    srcset={darkAvif.srcSet.attribute}
    sizes={sizes}
  />
  <source
    data-theme-source="dark"
    media={DARK}
    type="image/webp"
    srcset={darkWebp.srcSet.attribute}
    sizes={sizes}
  />
  <source type="image/avif" srcset={lightAvif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={lightWebp.srcSet.attribute} sizes={sizes} />
  <img
    src={lightWebp.src}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={loading}
    decoding={loading === "eager" ? "sync" : "async"}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>

<script>
  /** Point dark sources at the `.dark` class instead of the OS preference. */
  function syncThemePictures() {
    const dark = document.documentElement.classList.contains("dark");
    const osDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const media = dark === osDark ? "(prefers-color-scheme: dark)" : dark ? "all" : "not all";
    document.querySelectorAll<HTMLSourceElement>("[data-theme-source='dark']").forEach((s) => {
      if (s.media !== media) s.media = media;
    });
  }
  document.addEventListener("astro:page-load", syncThemePictures);
  document.addEventListener("themechange", syncThemePictures);
</script>
