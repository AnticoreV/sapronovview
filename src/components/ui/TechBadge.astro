---
/** Mono chip for a technology or tag (surface-sunken). Renders a link when `href` is set. */
interface Props {
  label: string;
  href?: string;
  current?: boolean;
  class?: string;
}
const { label, href, current = false, class: className } = Astro.props;
---

{href ? (
  <a href={href} class:list={["chip", className]} aria-current={current ? "page" : undefined}>
    {label}
  </a>
) : (
  <span class:list={["chip", className]}>{label}</span>
)}
