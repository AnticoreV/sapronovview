---
/** "What I'm building": own products as wide ProductModules (for partners and investors). */
import ProductModule from "@components/projects/ProductModule.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import type { Project } from "@lib/content";
import { i18n } from "@/i18n";

interface Props {
  products: Project[];
}
const { products } = Astro.props;
const { t } = i18n(Astro);
---

{products.length > 0 && (
  <section id="build" class="band section-gap" aria-labelledby="build-heading">
    <div class="shell flex flex-col gap-9">
      <SectionHeader id="build-heading" title={t("build.title")} />
      <ul class="flex flex-col gap-4">
        {products.map((p) => (
          <li class="flex">
            <ProductModule project={p} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
