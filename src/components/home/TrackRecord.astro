---
/**
 * "Track record": every position as a RecordRow (years · company · role · shipped),
 * "CV on request" (or "Download CV" once the file exists) and a "Full experience" link.
 */
import RecordRow from "@components/experience/RecordRow.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import type { Position } from "@lib/content";
import { cvPath } from "@lib/cv";
import { i18n } from "@/i18n";

interface Props {
  positions: Position[];
}
const { positions } = Astro.props;
const { t, l } = i18n(Astro);
---

<section id="experience" class="band section-gap" aria-labelledby="experience-heading">
  <div class="shell flex flex-col gap-7">
    <SectionHeader id="experience-heading" title={t("record.title")}>
      {cvPath ? (
        <a slot="action" href={cvPath} class="btn btn-secondary min-h-12 px-[22px]" download>
          {t("record.cvDownload")}
        </a>
      ) : (
        <a
          slot="action"
          href={l("/contact?topic=hiring")}
          class="btn btn-secondary min-h-12 px-[22px]"
        >
          {t("record.cvRequest")}
        </a>
      )}
    </SectionHeader>
    <div class="flex flex-col">
      <div
        class="label grid grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] gap-x-6 gap-y-1 border-b border-line py-3 text-ink-muted max-[640px]:hidden"
        aria-hidden="true"
      >
        <span>{t("record.years")}</span>
        <span>{t("record.company")}</span>
        <span>{t("record.role")}</span>
        <span>{t("record.shipped")}</span>
      </div>
      <ol>
        {positions.map((p) => (
          <li>
            <RecordRow position={p} />
          </li>
        ))}
      </ol>
      <p class="mt-7">
        <a href={l("/experience")} class="link-more">
          {t("record.full")}
        </a>
      </p>
    </div>
  </div>
</section>
