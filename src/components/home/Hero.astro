---
/**
 * Hero from the approved artboard (HeroV6): eyebrow, name in two lines, lede,
 * Email me + What I build, and the live "Blueprint" scene with its legend.
 */
import HeroStage from "@components/home/HeroStage.astro";
import { siteConfig } from "@config";

const [first, ...rest] = siteConfig.name.split(" ");
---

<section id="top" class="band pt-14 pb-6" aria-labelledby="hero-heading">
  <div class="shell flex flex-wrap items-center gap-x-10 gap-y-6">
    <div class="flex flex-[1_1_420px] flex-col gap-6">
      <p class="meta tracking-[0.06em] text-ink-muted">{siteConfig.hero.eyebrow}</p>
      <h1 id="hero-heading" class="display text-display-xl">
        {first}
        <br />
        {rest.join(" ")}
      </h1>
      <p class="max-w-[520px] text-body-l">{siteConfig.hero.lede}</p>
      <div class="flex flex-wrap items-center gap-3">
        <a href={`mailto:${siteConfig.email}`} class="btn btn-primary">
          Email me
        </a>
        <a href="#build" class="btn btn-secondary">
          What I build
        </a>
      </div>
    </div>
    <HeroStage />
  </div>
</section>
