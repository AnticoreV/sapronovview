---
/**
 * Hero: name, role line, lede, the three ways in (Let's work together → #contact, View
 * experience → #experience, the CV), four facts at a glance and the companies I've
 * worked with; the live "Blueprint" scene with its legend on the right.
 *
 * Layout: from 1130px the text column flexes between 440 and 560px (38vw) and the scene
 * takes the rest, so a laptop window never shows the text alone with empty space beside
 * it. Below that the scene moves under the text; once the text column is wider than
 * 720px (tablets, narrow desktop windows) the lede widens and the facts sit in one row.
 */
import HeroStage from "@components/home/HeroStage.astro";
import CvLink from "@components/ui/CvLink.astro";
import { siteConfig, siteCopy } from "@config";
import { heroFacts } from "@data/home";
import { i18n } from "@/i18n";

const { locale, t } = i18n(Astro);
const copy = siteCopy[locale];
const facts = heroFacts(locale);

const [first, ...rest] = siteConfig.name.split(" ");
---

<section id="top" class="hero-band band pt-14 pb-16" aria-labelledby="hero-heading">
  <div class="shell grid items-center gap-x-10 gap-y-8 min-[1130px]:grid-cols-[clamp(440px,38vw,560px)_minmax(0,1fr)]">
    <div class="@container flex min-w-0 flex-col gap-6">
      <div class="flex flex-col gap-4">
        <h1 id="hero-heading" class="display text-display-xl">
          {first}
          <br />
          {rest.join(" ")}
        </h1>
        <p class="display text-tagline text-accent">{copy.role}</p>
      </div>
      <p class="max-w-[560px] text-body-l @min-[720px]:max-w-[680px]">{copy.lede}</p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn btn-primary">
          {t("hero.work")}
        </a>
        <a href="#experience" class="btn btn-secondary">
          {t("hero.experience")}
        </a>
        <CvLink class="link-more" />
      </div>
      <dl
        class="grid max-w-[560px] grid-cols-2 gap-x-6 gap-y-4 border-t border-ink pt-5 @min-[720px]:max-w-none @min-[720px]:grid-cols-4"
        aria-label={t("hero.facts")}
      >
        {facts.map((f) => (
          <div>
            <dt class="mono text-[12px] text-ink-muted">{f.label}</dt>
            <dd class="mt-0.5 font-semibold">{f.value}</dd>
          </div>
        ))}
      </dl>
      <p class="label text-ink-muted">{t("proof.workedWith")}</p>
    </div>
    <HeroStage />
  </div>
</section>
