---
import { ArrowRight } from "lucide-astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import PlaceholderImage from "@components/ui/PlaceholderImage.astro";
import { Image } from "astro:assets";
import type { Hobby } from "@lib/content";
import { getIcon } from "@lib/icons";

interface Props {
  hobbies: Hobby[];
}
const { hobbies } = Astro.props;
---

<section class="border-border bg-surface-muted/60 border-y">
  <div class="container-site section reveal" aria-labelledby="hobbies-heading">
    <SectionHeading
      id="hobbies-heading"
      eyebrow="Beyond work"
      title="Engines, wings and borders"
      description="The things that keep me sane when the build is red."
    />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {hobbies.map((hobby) => {
        const Icon = getIcon(hobby.data.icon);
        const img = hobby.data.images[0];
        return (
          <li class="card card-hover group relative overflow-hidden">
            {img?.src ? (
              <Image
                src={img.src}
                alt={img.alt}
                width={600}
                height={450}
                widths={[300, 600]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-[4/3] w-full object-cover"
              />
            ) : (
              <PlaceholderImage
                label={hobby.data.title}
                ratio="4/3"
                class="rounded-none border-0 border-b"
              />
            )}
            <div class="p-5">
              <span class="bg-accent-soft text-accent-strong inline-flex size-9 items-center justify-center rounded-lg">
                <Icon size={18} aria-hidden="true" />
              </span>
              <h3 class="mt-3 text-lg">
                <a
                  href={`/hobbies#${hobby.id}`}
                  class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
                >
                  {hobby.data.title}
                </a>
              </h3>
              <p class="text-fg-muted mt-1 text-sm">{hobby.data.tagline}</p>
              <ArrowRight
                size={16}
                aria-hidden="true"
                class="text-fg-subtle group-hover:text-accent-strong mt-4 transition-all group-hover:translate-x-0.5"
              />
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
