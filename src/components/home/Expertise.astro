---
/**
 * "What I do": five ExpertiseCards (src/data/home.ts). On desktop the first two (backend,
 * AI automation) share a wide row and the other three sit below; two columns on tablets
 * (the fifth card spans both), one on phones.
 */
import ExpertiseCard from "@components/home/ExpertiseCard.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import { expertise as expertiseFor } from "@data/home";
import { i18n } from "@/i18n";

const { locale, t } = i18n(Astro);
const cards = expertiseFor(locale);
---

<section id="expertise" class="band section-gap" aria-labelledby="expertise-heading">
  <div class="shell flex flex-col gap-9">
    <SectionHeader id="expertise-heading" title={t("expertise.title")} />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {cards.map((c, i) => (
        <ExpertiseCard
          id={c.id}
          title={c.title}
          text={c.text}
          stack={c.stack}
          spotlight={c.spotlight}
          class={
            i < 2
              ? "lg:col-span-3"
              : i === cards.length - 1
                ? "sm:col-span-2 lg:col-span-2"
                : "lg:col-span-2"
          }
        />
      ))}
    </ul>
  </div>
</section>
