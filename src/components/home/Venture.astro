---
/**
 * "My own product": Ownira as a side venture next to client work (one line of context,
 * then the wide ProductModule with status, audience, role and web).
 */
import ProductModule from "@components/projects/ProductModule.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import { ventureIntro } from "@data/home";
import type { Project } from "@lib/content";
import { i18n } from "@/i18n";

interface Props {
  products: Project[];
}
const { products } = Astro.props;
const { locale, t } = i18n(Astro);
---

{products.length > 0 && (
  <section id="product" class="band section-gap" aria-labelledby="product-heading">
    <div class="shell flex flex-col gap-7">
      <SectionHeader id="product-heading" title={t("venture.title")} />
      <p class="max-w-[640px] text-body-l text-ink-muted">{ventureIntro(locale)}</p>
      <ul class="flex flex-col gap-4">
        {products.map((p) => (
          <li class="flex">
            <ProductModule project={p} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
