---
/** "Writing": the latest posts as rows (same style as the case rows), once one is published. */
import type { Post } from "@lib/content";
import SectionHeader from "@components/ui/SectionHeader.astro";
import { i18n } from "@/i18n";

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const { locale, t, l } = i18n(Astro);
---

{posts.length > 0 && (
  <section id="journal" class="band section-gap" aria-labelledby="journal-heading">
    <div class="shell flex flex-col gap-7">
      <SectionHeader
        id="journal-heading"
        title={t("writing.title")}
        href={l("/writing")}
        linkLabel={t("writing.all")}
      />
      <ul class="flex flex-col gap-3">
        {posts.map((post) => (
          <li>
            <a
              href={l(`/writing/${post.id}`)}
              lang={locale === "cs" ? "en" : undefined}
              class="post card lift grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] items-start gap-x-8 gap-y-3 p-7 no-underline"
            >
              <h3 class="display text-heading">{post.data.title}</h3>
              <p class="text-ink-muted">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <span class="mono text-[12px] text-ink-muted">{post.data.tags.join(" · ")}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .post:hover {
    color: var(--ink);
  }
</style>
