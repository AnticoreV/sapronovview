---
/**
 * "Experience", variant A, scroll rail: every position in a vertical list. From 1024px a
 * sticky panel on the left follows the position in view (years, company, the shipped
 * line, "02 / 05") above a rail of all positions that fills as you scroll; its stops
 * jump to their position. The position in view is at full strength, the others dim. On
 * phones the list keeps its own progress line. Without JS it is a plain list.
 */
import CvLink from "@components/ui/CvLink.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import ExperienceDetail from "@components/home/ExperienceDetail.astro";
import type { Position } from "@lib/content";
import { timelineItems } from "@lib/timeline";
import { i18n } from "@/i18n";

interface Props {
  positions: Position[];
}
const { positions } = Astro.props;
const { locale, t, l } = i18n(Astro);
const items = timelineItems(positions, locale, t("experience.present"));
const total = String(items.length).padStart(2, "0");
const panelData = items.map((p) => ({
  years: p.years,
  company: p.company,
  shipped: p.shipped ?? "",
}));
const first = items[0]!;
---

<section
  id="experience"
  class="band section-gap"
  aria-labelledby="experience-heading"
  data-rail-timeline
  data-items={JSON.stringify(panelData)}
>
  <div class="shell flex flex-col gap-9">
    <SectionHeader id="experience-heading" title={t("experience.title")}>
      <CvLink slot="action" class="btn btn-secondary min-h-12 px-[22px]" />
    </SectionHeader>
    <div class="grid gap-10 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-16">
      <div class="max-lg:hidden">
        <div class="rail-panel sticky top-28 flex flex-col gap-8">
          <div class="rail-now" aria-hidden="true" data-rail-now>
            <p class="mono text-[12px] text-ink-muted">
              <span data-rail-count>01</span> / {total}
            </p>
            <p class="display mt-2 text-numeral" data-rail-years>
              {first.years}
            </p>
            <p class="mt-3 font-semibold" data-rail-company>
              {first.company}
            </p>
            <p class="mono mt-1 min-h-[1.5em] text-[13px] text-ink-muted" data-rail-shipped>
              {first.shipped}
            </p>
          </div>
          <nav aria-label={t("experience.positions")}>
            <ul class="rail">
              {items.map((p, i) => (
                <li>
                  <a
                    href={`#exp-${p.id}`}
                    class="rail-stop"
                    data-rail-stop={i}
                    aria-current={i === 0 ? "true" : undefined}
                  >
                    <span class="mono w-[58px] shrink-0 text-[12px]">{p.years}</span>
                    <span class="truncate">{p.company}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
      <ol class="entries" data-rail-entries>
        {items.map((p, i) => (
          <li id={`exp-${p.id}`} class:list={["entry", i === 0 && "is-active"]} data-rail-entry={i}>
            <ExperienceDetail item={p} wide />
          </li>
        ))}
      </ol>
    </div>
    <p>
      <a href={l("/experience")} class="link-more">
        {t("record.full")}
      </a>
    </p>
  </div>
</section>

<style>
  /* Entries: a 1px rule with a gradient fill that follows the scroll (--progress). */
  .entries {
    position: relative;
  }
  .entries::before,
  .entries::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 10px;
    width: 1px;
    background: var(--line);
  }
  .entries::before {
    bottom: 56px;
  }
  .entries::after {
    left: 3px;
    width: 3px;
    border-radius: 2px;
    height: calc((100% - 66px) * var(--progress, 0));
    background: linear-gradient(180deg, var(--accent), var(--accent-2), var(--accent-3));
  }
  .entry {
    position: relative;
    padding: 0 0 56px 36px;
    transition: opacity 320ms var(--ease-out);
  }
  .entry::before {
    content: "";
    position: absolute;
    top: 0.3em;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--line-strong);
    transition:
      background-color 320ms var(--ease-out),
      transform 320ms var(--ease-out);
  }
  .entry.is-active::before {
    background: var(--accent);
    transform: rotate(45deg) scale(1.3);
  }
  [data-rail-timeline].is-live .entry:not(.is-active) {
    opacity: 0.42;
  }

  /* Rail: every position, a track that fills with --progress, the current stop marked. */
  .rail {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: 24px;
  }
  .rail::before,
  .rail::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: var(--line);
  }
  .rail::after {
    left: 3px;
    width: 3px;
    border-radius: 2px;
    bottom: auto;
    height: calc((100% - 28px) * var(--progress, 0));
    background: linear-gradient(180deg, var(--accent), var(--accent-2), var(--accent-3));
  }
  .rail-stop {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-height: 44px;
    padding-block: 10px;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .rail-stop::before {
    content: "";
    position: absolute;
    left: -24px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--line-strong);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .rail-stop:hover {
    color: var(--ink);
  }
  .rail-stop[aria-current="true"] {
    color: var(--ink);
    font-weight: 600;
  }
  .rail-stop[aria-current="true"]::before {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.35);
  }

  /* The panel's text slides in when the position in view changes. */
  .rail-now.is-swapping > * {
    animation: rail-in 420ms var(--ease-out) both;
  }
  .rail-now.is-swapping > :nth-child(3) {
    animation-delay: 40ms;
  }
  .rail-now.is-swapping > :nth-child(4) {
    animation-delay: 80ms;
  }
  @keyframes rail-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .entry,
    .entry::before,
    .rail-stop::before {
      transition: none;
    }
    .rail-now.is-swapping > * {
      animation: none;
    }
  }
</style>

<script>
  type PanelItem = { years: string; company: string; shipped: string };

  function setupRail() {
    const root = document.querySelector<HTMLElement>("[data-rail-timeline]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";
    root.classList.add("is-live");
    const data = JSON.parse(root.dataset.items ?? "[]") as PanelItem[];
    const list = root.querySelector<HTMLElement>("[data-rail-entries]")!;
    const entries = [...root.querySelectorAll<HTMLElement>("[data-rail-entry]")];
    const stops = [...root.querySelectorAll<HTMLElement>("[data-rail-stop]")];
    const now = root.querySelector<HTMLElement>("[data-rail-now]");
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-rail-${name}]`);
    const [count, years, company, shipped] = ["count", "years", "company", "shipped"].map(field);

    let active = 0;
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      entries.forEach((e, k) => e.classList.toggle("is-active", k === i));
      stops.forEach((s, k) =>
        k === i ? s.setAttribute("aria-current", "true") : s.removeAttribute("aria-current"),
      );
      const d = data[i];
      if (!d || !now) return;
      if (count) count.textContent = String(i + 1).padStart(2, "0");
      if (years) years.textContent = d.years;
      if (company) company.textContent = d.company;
      if (shipped) shipped.textContent = d.shipped;
      now.classList.remove("is-swapping");
      void now.offsetWidth;
      now.classList.add("is-swapping");
    };

    const update = () => {
      const line = innerHeight * 0.45;
      const box = list.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (line - box.top) / box.height));
      root.style.setProperty("--progress", progress.toFixed(4));
      let i = 0;
      entries.forEach((e, k) => {
        if (e.getBoundingClientRect().top <= line) i = k;
      });
      setActive(i);
    };
    let frame = 0;
    const onScroll = () => {
      if (!frame)
        frame = requestAnimationFrame(() => {
          frame = 0;
          update();
        });
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    document.addEventListener(
      "astro:before-swap",
      () => {
        removeEventListener("scroll", onScroll);
        removeEventListener("resize", onScroll);
      },
      { once: true },
    );
    update();
  }
  document.addEventListener("astro:page-load", setupRail);
</script>
