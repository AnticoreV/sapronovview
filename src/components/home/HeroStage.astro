---
/**
 * The live hero scene "V6 · Blueprint" (src/scripts/hero3d.ts) in its frame
 * (radius-md, soft edge mask), with the legend underneath. The poster is the LCP
 * element and the fallback: under reduced motion, without WebGL or without JS it is
 * all there is, and three.js is never downloaded. Otherwise the scene loads lazily —
 * on idle once the stage is visible (desktop with a mouse), or on the first scroll /
 * touch / key on phones — renders the poster's frame and fades in over it.
 */
import ThemePicture from "@components/ui/ThemePicture.astro";
import posterLight from "@/assets/hero/blueprint-light.png";
import posterDark from "@/assets/hero/blueprint-dark.png";

// The artboard's description of the drawing (screens/HeroV6.dc.html).
const description =
  "An isometric technical drawing builds itself: three idea sketches, two struck out at a validation gate; the architecture (frontend, backend, services) is drawn stroke by stroke and filled with colour; tests stamp checks; a rose review mark erases one link and redraws it through a queue; dashed CI/CD arrows carry a package to a deploy target where service blocks extrude; a sparkline draws on an observe card; a rose pen-orb flies back along the agent loop and sketches the next idea while the sheet clears.";
// Measured: beside the name (≥ 1270px viewport) the stage is ≤ 800px wide (797 at 1440);
// below that it takes the full width.
const sizes = "(min-width: 1270px) 800px, 100vw";
const widths = [480, 640, 800, 1200, 1594];
// HeroLegend, exactly as the V6 artboard: an ink line for DRAWN, clay dots for the rest.
const legend = [
  { label: "IDEA", dot: "bg-clay-butter" },
  { label: "BUILT · SHIPPED", dot: "bg-clay-blue" },
  { label: "TESTED · RUNNING", dot: "bg-clay-mint" },
  { label: "REVIEW · AGENT LOOP", dot: "bg-clay-rose" },
];
---

<figure class="hero-media m-0 flex min-w-0 flex-[999_1_640px] flex-col gap-2.5">
  <div
    class="hero-stage relative aspect-[16/10] w-full overflow-hidden rounded-md bg-bg"
    data-hero-stage
    role="img"
    aria-label={description}
  >
    <span class="hero-poster">
      <ThemePicture
        light={posterLight}
        dark={posterDark}
        alt=""
        widths={widths}
        sizes={sizes}
        loading="eager"
        fetchpriority="high"
      />
    </span>
    <canvas class="hero-canvas" aria-hidden="true"></canvas>
  </div>
  <figcaption class="mono flex flex-wrap justify-center gap-x-5 gap-y-2 px-4 text-[12px] font-medium text-ink-muted">
    <span class="inline-flex items-center gap-[7px]">
      <i class="inline-block h-0 w-3.5 border-t-2 border-ink" aria-hidden="true"></i>DRAWN
    </span>
    {legend.map((l) => (
      <span class="inline-flex items-center gap-[7px]">
        <i class:list={["inline-block size-[9px] rounded-full", l.dot]} aria-hidden="true"></i>
        {l.label}
      </span>
    ))}
    <span>SKETCH → BUILD → SHIP → LEARN</span>
  </figcaption>
</figure>

<style>
  /* Soft edge mask from the artboard (2.5% sides, 4% top / bottom). */
  .hero-stage {
    -webkit-mask-image:
      linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent),
      linear-gradient(180deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent),
      linear-gradient(180deg, transparent, #000 4%, #000 96%, transparent);
    mask-composite: intersect;
  }
  /* ≤ 860px the media stacks under the text, full-bleed. */
  @media (max-width: 53.75rem) {
    .hero-media {
      margin-inline: calc(-1 * var(--gutter));
    }
    .hero-stage {
      border-radius: 0;
    }
  }
  .hero-poster,
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-poster :global(picture) {
    display: contents;
  }
  .hero-poster :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-canvas {
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hero-stage[data-live] .hero-canvas {
    opacity: 1;
  }
  .hero-stage[data-live-settled] .hero-poster {
    visibility: hidden;
  }
</style>

<script>
  import type { HeroHandle } from "@/scripts/hero3d";

  let handle: HeroHandle | undefined;

  const reducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Cheap WebGL probe so three.js is never fetched when it could not run. */
  function hasWebGL(): boolean {
    try {
      const c = document.createElement("canvas");
      const gl = (c.getContext("webgl2") || c.getContext("webgl")) as WebGLRenderingContext | null;
      gl?.getExtension("WEBGL_lose_context")?.loseContext();
      return Boolean(gl);
    } catch {
      return false;
    }
  }

  function whenIdle(cb: () => void) {
    if ("requestIdleCallback" in window) window.requestIdleCallback(cb, { timeout: 2500 });
    else setTimeout(cb, 300);
  }

  /**
   * Desktop with a mouse: on idle. Phones / touch: on the first scroll, touch or key —
   * the poster shows the same frame, so nobody pays for WebGL they never look at.
   */
  function whenReady(cb: () => void) {
    if (!window.matchMedia("(pointer: coarse), (max-width: 767px)").matches) return whenIdle(cb);
    const events = ["pointerdown", "scroll", "keydown", "wheel", "touchstart"] as const;
    const go = () => {
      events.forEach((e) => window.removeEventListener(e, go));
      whenIdle(cb);
    };
    events.forEach((e) => window.addEventListener(e, go, { once: true, passive: true }));
  }

  async function start(stage: HTMLElement, capture?: { dpr: number }) {
    const canvas = stage.querySelector<HTMLCanvasElement>(".hero-canvas");
    if (!canvas) return;
    // Probe WebGL only now (creating a context can be slow on GPU-less machines).
    if (!capture && !hasWebGL()) return;
    try {
      const { mountHero } = await import("@/scripts/hero3d");
      if (!stage.isConnected) return;
      handle = await mountHero(canvas, {
        capture,
        onFirstFrame: () => {
          stage.dataset.live = "";
          window.setTimeout(() => (stage.dataset.liveSettled = ""), 500);
          if (capture) (window as unknown as { __heroReady?: boolean }).__heroReady = true;
        },
      });
    } catch (err) {
      // Keep the poster — it shows the same frame.
      console.warn("[hero3d] staying on the poster:", err);
    }
  }

  function init() {
    const stage = document.querySelector<HTMLElement>("[data-hero-stage]");
    if (!stage || stage.dataset.bound) return;
    stage.dataset.bound = "true";

    // Poster capture for scripts/render-posters.mjs: render now at a fixed DPR.
    const params = new URLSearchParams(window.location.search);
    if (params.has("hero-capture")) {
      void start(stage, { dpr: Number(params.get("hero-capture")) || 2 });
      return;
    }
    if (reducedMotion()) return;

    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      whenReady(() => void start(stage));
    });
    io.observe(stage);
  }

  function teardown() {
    handle?.dispose();
    handle = undefined;
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", teardown);
  window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", (e) => {
    if (!e.matches) return;
    teardown();
    const stage = document.querySelector<HTMLElement>("[data-hero-stage]");
    if (stage) {
      delete stage.dataset.live;
      delete stage.dataset.liveSettled;
    }
  });
</script>
