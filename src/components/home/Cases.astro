---
/** Selected case studies on a kneeboard sheet. */
import { homeCases } from "@data/home";
import type { Project } from "@lib/content";

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const cases = homeCases.filter((c) => projects.some((p) => p.id === c.slug));
---

{cases.length > 0 && (
  <section id="work" class="band pb-16 md:pb-24" aria-labelledby="work-heading">
    <div class="shell sheet flex flex-col gap-7 px-[clamp(20px,4vw,56px)] py-10 md:py-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="work-heading" class="display text-display-l">
          Case studies
        </h2>
        <a href="/projects" class="link-ghost inline-flex min-h-11 items-center">
          All projects<span aria-hidden="true">&nbsp;→</span>
        </a>
      </div>
      <ul class="flex flex-col border-t-2 border-ink">
        {cases.map((c) => (
          <li>
            <a
              href={`/projects/${c.slug}`}
              class="case-row grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-x-8 gap-y-2 border-b border-panel-edge py-[26px] no-underline"
            >
              <span class="text-[26px] leading-[1.1] font-bold">{c.title}</span>
              <span class="text-ink-muted">{c.summary}</span>
              <span class="mono text-xs leading-relaxed text-ink-muted uppercase">
                {c.meta[0]}
                <br />
                {c.meta[1]}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .case-row:hover span:first-child {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
</style>
