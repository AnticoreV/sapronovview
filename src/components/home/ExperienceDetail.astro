---
/**
 * One position in the homepage Experience timeline: dates, type and duration; role and
 * company; the one-line result ("Shipped"); the three strongest achievements; and the
 * technologies, beside the text from 1200px when `wide`, under it otherwise.
 */
import TechBadge from "@components/ui/TechBadge.astro";
import type { TimelineItem } from "@lib/timeline";
import { i18n } from "@/i18n";

interface Props {
  item: TimelineItem;
  /** Technologies in a column beside the text from 1200px. */
  wide?: boolean;
  class?: string;
}
const { item, wide = false, class: className } = Astro.props;
const { t } = i18n(Astro);
---

<div
  class:list={[
    "grid gap-x-12 gap-y-5",
    wide && "min-[1200px]:grid-cols-[minmax(0,1fr)_260px]",
    className,
  ]}
>
  <div class="min-w-0">
    <p class="mono text-[13px] font-medium text-accent">
      {item.range}
      <span class="text-ink-muted">
        {" "}
        · {item.type} · {item.duration}
      </span>
    </p>
    <h3 class="display mt-1.5 text-heading">{item.role}</h3>
    <p class="mt-1 text-ink-muted">
      <span class="font-semibold text-ink">{item.company}</span>
      {item.location && <span> · {item.location}</span>}
    </p>
    {item.shipped && (
      <p class="mt-3 text-[15px]">
        <span class="label text-ink-muted">{t("record.shipped")}</span>
        <span class="ml-2 font-semibold">{item.shipped}</span>
      </p>
    )}
    <ul class="mt-4 flex max-w-[68ch] list-disc flex-col gap-2 pl-5 marker:text-line-strong">
      {item.achievements.map((a) => (
        <li>{a}</li>
      ))}
    </ul>
  </div>
  {item.technologies.length > 0 && (
    <div class:list={["flex flex-col gap-2.5", wide && "min-[1200px]:pt-1.5"]}>
      <p class="label text-ink-muted" aria-hidden="true">
        {t("experience.technologies")}
      </p>
      <ul class="flex flex-wrap gap-1.5" aria-label={t("experience.technologies")}>
        {item.technologies.map((tech) => (
          <li>
            <TechBadge label={tech} class="bg-surface" />
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
