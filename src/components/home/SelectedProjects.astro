---
import ProjectCard from "@components/projects/ProjectCard.astro";
import Button from "@components/ui/Button.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import type { Project } from "@lib/content";

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const [first, ...rest] = projects;
---

<section class="container-site section reveal" aria-labelledby="selected-projects">
  <SectionHeading
    id="selected-projects"
    eyebrow="Selected work"
    title="Projects I'm proud of"
    description="Case studies, not just cards — what the problem was, what I built and what I'd change."
  >
    <Button slot="action" href="/projects" variant="secondary" size="sm" arrow>
      All projects
    </Button>
  </SectionHeading>

  <div class="grid gap-5 sm:gap-6">
    {first && <ProjectCard project={first} variant="feature" eager />}
    <div class="grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {rest.map((p) => (
        <ProjectCard project={p} />
      ))}
    </div>
  </div>
</section>
