---
/**
 * "Off duty": hobbies as one line (an addition, not the subject) and a "Hobbies & map"
 * link. While a post is published, the Writing rows render above it (same style as the
 * cases).
 */
import type { Post } from "@lib/content";
import SectionHeader from "@components/ui/SectionHeader.astro";
import { i18n } from "@/i18n";

interface Props {
  posts: Post[];
  countries: number;
}
const { posts, countries } = Astro.props;
const { locale, t, l } = i18n(Astro);
const offDuty = t("offduty.line", { countries: t("countries", { n: countries }) });
---

{posts.length > 0 && (
  <section id="journal" class="band section-gap" aria-labelledby="journal-heading">
    <div class="shell flex flex-col gap-7">
      <SectionHeader
        id="journal-heading"
        title={t("writing.title")}
        href={l("/writing")}
        linkLabel={t("writing.all")}
      />
      <ul class="flex flex-col gap-3">
        {posts.map((post) => (
          <li>
            <a
              href={l(`/writing/${post.id}`)}
              lang={locale === "cs" ? "en" : undefined}
              class="post card lift grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] items-start gap-x-8 gap-y-3 p-7 no-underline"
            >
              <h3 class="text-[26px] leading-[1.15] font-bold tracking-[-0.02em]">
                {post.data.title}
              </h3>
              <p class="text-ink-muted">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <span class="mono text-[12px] text-ink-muted">{post.data.tags.join(" · ")}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<section id="off-duty" class="band section-gap" aria-labelledby="off-duty-heading">
  <div class="shell card flex flex-wrap items-center justify-between gap-x-8 gap-y-4 px-7 py-6">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
      <h2 id="off-duty-heading" class="label text-ink-muted">
        {t("offduty.title")}
      </h2>
      <p class="text-[18px]">{offDuty}</p>
    </div>
    <a href={l("/hobbies")} class="link-more">
      {t("offduty.link")}
    </a>
  </div>
</section>

<style>
  .post:hover {
    color: var(--ink);
  }
</style>
