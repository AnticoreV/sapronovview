---
/**
 * "Tech stack": the CV's skills by category (src/data/stack.ts), one row per category.
 * Core chips (everyday stack) are solid; "worked with" chips are dashed and muted, so
 * the split reads without percentages or ratings. Screen readers get two named lists.
 * From 1100px the categories run down two columns (five rows each), so the chips fill
 * the width instead of leaving the right half of the page empty.
 */
import SectionHeader from "@components/ui/SectionHeader.astro";
import { stack } from "@data/stack";
import { i18n } from "@/i18n";

const { locale, t } = i18n(Astro);
const rows = Math.ceil(stack.length / 2);
---

<section id="stack" class="band section-gap" aria-labelledby="stack-heading">
  <div class="shell flex flex-col gap-7">
    <SectionHeader id="stack-heading" title={t("stack.title")}>
      <p
        slot="action"
        class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[14px] text-ink-muted"
      >
        <span class="inline-flex items-center gap-2">
          <span class="chip chip-core">{t("stack.core")}</span>
          {t("stack.coreNote")}
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="chip chip-also">{t("stack.also")}</span>
          {t("stack.alsoNote")}
        </span>
      </p>
    </SectionHeader>
    <dl
      class="grid min-[1100px]:grid-flow-col min-[1100px]:grid-cols-2 min-[1100px]:grid-rows-[repeat(var(--stack-rows),auto)] min-[1100px]:gap-x-12"
      style={`--stack-rows: ${rows}`}
    >
      {stack.map((g) => (
        <div class="grid content-start gap-x-6 gap-y-2.5 border-b border-line py-4 sm:grid-cols-[160px_1fr]">
          <dt class="pt-1 font-semibold">{g.label[locale]}</dt>
          <dd class="flex flex-wrap gap-1.5">
            <ul class="flex flex-wrap gap-1.5" aria-label={t("stack.core")}>
              {g.core.map((item) => (
                <li class="chip chip-core">{item}</li>
              ))}
            </ul>
            {g.also.length > 0 && (
              <ul class="flex flex-wrap gap-1.5" aria-label={t("stack.also")}>
                {g.also.map((item) => (
                  <li class="chip chip-also">{item}</li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .chip-core {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .chip-also {
    background: transparent;
    color: var(--ink-muted);
    font-weight: 500;
    outline: 1px dashed var(--line-strong);
    outline-offset: -1px;
  }
</style>
