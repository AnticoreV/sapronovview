---
/**
 * Adventures: the live paper globe (or, under reduced motion / without WebGL,
 * the d3-geo SVG map) with the country list and details beside it.
 * Data: src/data/adventures.ts.
 */
import AdventureDetails from "@components/adventures/AdventureDetails.astro";
import AdventureMap from "@components/adventures/AdventureMap.astro";
import GlobeStage from "@components/adventures/GlobeStage.astro";
import MapLegend from "@components/adventures/MapLegend.astro";
import { adventures } from "@data/adventures";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const countries = new Set(
  adventures.filter((a) => a.status === "visited").map((a) => a.countryCode),
).size;
---

<section
  id="adventures"
  class:list={["adventures band", className]}
  aria-labelledby="adventures-heading"
  data-adventures
>
  <div class="shell">
    <slot name="before" />
    <p class="label mt-8 text-ink-muted">Off duty · adventures</p>
    <h1 id="adventures-heading" class="display mt-3 text-display-l">
      {countries} countries on the map
    </h1>
    <p class="mt-5 max-w-[640px] text-body-l">
      Where I've been, home in Prague, and the places still on the list. Drag the globe to turn it;
      pick a country or a place in the list to fly there.
    </p>

    <div class="mt-10 grid items-start gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(300px,1fr)]">
      <div class="adv-visual flex flex-col gap-4 lg:sticky lg:top-24" data-adv-visual>
        <GlobeStage />
        {/* Fallback map: parsed only when needed (reduced motion / no WebGL), so the
            globe page does not carry ~45 KB of hidden SVG. */}
        <template data-adv-fallback-template>
          <div class="adv-fallback sheet p-2 sm:p-3">
            <AdventureMap locations={adventures} />
          </div>
        </template>
        <MapLegend />
      </div>
      <aside class="module p-6" aria-label="Countries and places">
        <AdventureDetails locations={adventures} />
      </aside>
    </div>
  </div>
</section>

<style>
  .adventures {
    --adventure-marker-size: 11px;
    --adventure-marker-hit: 32px;
    --adventure-water: var(--panel-sheet);
    --adventure-land: var(--panel-raised);
    --adventure-land-active: var(--ink);
    --adventure-border: var(--panel-edge-strong);
  }
  @media (pointer: coarse) {
    .adventures {
      --adventure-marker-hit: 44px;
    }
  }
  .adv-visual[data-globe="off"] :global(.globe-stage) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .adv-visual :global(.globe-stage) {
      display: none;
    }
  }
</style>

<script>
  /** Instantiate the SVG map when the globe cannot (or should not) run. */
  function mountFallback() {
    const visual = document.querySelector<HTMLElement>("[data-adv-visual]");
    const template = visual?.querySelector<HTMLTemplateElement>("[data-adv-fallback-template]");
    if (!visual || !template || visual.querySelector(".adv-fallback")) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduced && visual.dataset.globe !== "off") return;
    template.after(template.content.cloneNode(true));
    document.dispatchEvent(new CustomEvent("adventure:map-mounted"));
  }
  document.addEventListener("astro:page-load", () => {
    mountFallback();
    const visual = document.querySelector<HTMLElement>("[data-adv-visual]");
    if (!visual || visual.dataset.fallbackWatch) return;
    visual.dataset.fallbackWatch = "true";
    new MutationObserver(mountFallback).observe(visual, {
      attributes: true,
      attributeFilter: ["data-globe"],
    });
  });
</script>
