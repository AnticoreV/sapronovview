---
/**
 * "Adventures" section: heading, interactive map, legend and details panel.
 *
 * Drop <AdventuresSection /> into any page. Data lives in src/data/adventures.ts.
 * Colours and sizes are exposed as CSS custom properties on the section so
 * they can be themed without touching the components.
 */
import SectionHeading from "@components/ui/SectionHeading.astro";
import AdventureMap from "@components/adventures/AdventureMap.astro";
import AdventureDetails from "@components/adventures/AdventureDetails.astro";
import MapLegend from "@components/adventures/MapLegend.astro";
import { adventures, getAdventuresByStatus } from "@data/adventures";

interface Props {
  id?: string;
  title?: string;
  description?: string;
  eyebrow?: string;
}
const {
  id = "adventures",
  eyebrow = "Adventures",
  title = "Places I've been, places I'm going",
  description = "A map of the countries I've visited and the ones still on the list. Tap a marker for the story, or a highlighted country for everything in it.",
} = Astro.props;

const visited = getAdventuresByStatus("visited");
const wishlist = getAdventuresByStatus("wishlist");
---

<section
  id={id}
  class="adventures container-site section reveal"
  aria-labelledby={`${id}-heading`}
  data-adventures
>
  <SectionHeading id={`${id}-heading`} eyebrow={eyebrow} title={title} description={description} />

  <div class="adventures__layout">
    <div class="adventures__map card">
      <AdventureMap locations={adventures} />
      <div class="adventures__legend">
        <MapLegend visitedCount={visited.length} wishlistCount={wishlist.length} />
      </div>
    </div>
    <aside class="adventures__details card" aria-label="Location details">
      <AdventureDetails locations={adventures} />
    </aside>
  </div>
</section>

<style>
  .adventures {
    /* Theme hooks — override these on the section to restyle the map. */
    --adventure-visited: var(--accent);
    --adventure-wishlist: var(--fg-muted);
    --adventure-marker-size: 12px;
    --adventure-marker-hit: 32px;
    --adventure-water: transparent;
    --adventure-land: var(--surface-strong);
    --adventure-land-active: color-mix(in oklab, var(--accent) 22%, var(--surface-strong));
    --adventure-border: var(--surface);
  }
  @media (pointer: coarse) {
    .adventures {
      --adventure-marker-hit: 44px;
    }
  }

  .adventures__layout {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .adventures__layout {
      grid-template-columns: minmax(0, 1.9fr) minmax(280px, 1fr);
    }
  }

  .adventures__map {
    overflow: hidden;
    padding: 0.5rem;
  }
  .adventures__legend {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0.5rem 0.25rem;
  }
  .adventures__details {
    padding: 1.25rem;
    max-height: 32rem;
    overflow-y: auto;
  }
  @media (min-width: 64rem) {
    .adventures__details {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 6.5rem);
    }
  }
</style>
