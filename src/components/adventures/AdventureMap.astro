---
/**
 * Flat world map — the fallback for the globe (reduced motion, no WebGL).
 *
 * The map itself (/images/adventures-map-base.svg, built from world-atlas with
 * d3-geo at build time) is fetched and inlined only when this fallback is shown,
 * so the globe page does not carry it. It is a picture, not a control: places are
 * picked in the country list, and the map mirrors the selection (`adventure:select`).
 */
import { adventures } from "@data/adventures";

const visited = new Set(adventures.filter((a) => a.status === "visited").map((a) => a.country))
  .size;
---

<figure class="adv-map" data-adv-map data-src="/images/adventures-map-base.svg">
  <div class="adv-map__stage" data-adv-stage></div>
  <figcaption class="sr-only">
    World map: {visited} visited countries in ink, home in the Czech Republic highlighted, wishlist
    countries outlined. Use the country list to pick a place.
  </figcaption>
</figure>

<style>
  .adv-map {
    margin: 0;
  }
  .adv-map__stage {
    aspect-ratio: 960 / 500;
    width: 100%;
  }
  .adv-map__stage :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .adv-map__stage :global(.c) {
    fill: var(--panel-raised);
    stroke: var(--panel-edge-strong);
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
  }
  .adv-map__stage :global(.c.v) {
    fill: var(--ink);
  }
  .adv-map__stage :global(.c.h) {
    fill: var(--route);
  }
  .adv-map__stage :global(.c.w) {
    stroke: var(--route);
    stroke-width: 1.4;
    stroke-dasharray: 3 2;
  }
  .adv-map__stage :global(.c.is-selected) {
    stroke: var(--select);
    stroke-width: 2;
    stroke-dasharray: none;
  }
  .adv-map__stage :global(.m) {
    fill: var(--route);
    stroke: var(--panel-sheet);
    stroke-width: 1.5;
  }
  .adv-map__stage :global(.m-w) {
    fill: var(--panel-sheet);
    stroke: var(--route);
    stroke-width: 2;
  }
  .adv-map__stage :global(.m.is-selected) {
    r: 7px;
    stroke: var(--ink);
    stroke-width: 2.5;
  }
</style>

<script>
  type Selection = { id?: string | null; country?: string | null };

  async function loadMap(root: HTMLElement) {
    if (root.dataset.loaded) return;
    root.dataset.loaded = "true";
    const stage = root.querySelector<HTMLElement>("[data-adv-stage]");
    if (!stage || !root.dataset.src) return;
    try {
      const response = await fetch(root.dataset.src);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      // Same-origin SVG generated at build time from our own data.
      stage.innerHTML = await response.text();
    } catch {
      delete root.dataset.loaded;
      return;
    }
    const section = root.closest<HTMLElement>("[data-adventures]") ?? document.body;
    section.addEventListener("adventure:select", (e: Event) => {
      const { id = null, country = null } = (e as CustomEvent<Selection>).detail ?? {};
      const marker = id ? stage.querySelector<SVGElement>(`.m[data-id="${id}"]`) : null;
      const code = marker?.dataset.c ?? country;
      stage.querySelectorAll(".is-selected").forEach((el) => el.classList.remove("is-selected"));
      marker?.classList.add("is-selected");
      if (code) stage.querySelector(`.c[data-c="${code}"]`)?.classList.add("is-selected");
    });
  }

  /** Load the map once its container is actually displayed. */
  function syncMaps() {
    document.querySelectorAll<HTMLElement>("[data-adv-map]").forEach((root) => {
      if (root.offsetParent !== null) void loadMap(root);
    });
  }
  document.addEventListener("astro:page-load", syncMaps);
  document.addEventListener("adventure:fallback", syncMaps);
</script>
