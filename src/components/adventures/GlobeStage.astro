---
/**
 * Live 3D paper globe (src/scripts/globe3d.ts) over a matching poster. Under
 * reduced motion or without WebGL the stage is replaced by the d3-geo SVG map
 * (see AdventuresSection) and three.js is never downloaded.
 */
import ThemePicture from "@components/ui/ThemePicture.astro";
import posterDay from "@/assets/globe/globe-day.png";
import posterNight from "@/assets/globe/globe-night.png";
import { adventures, home } from "@data/adventures";

const visited = new Set(adventures.filter((a) => a.status === "visited").map((a) => a.countryCode));
const alt = `Globe centred on Europe: ${visited.size} visited countries in ink, home in ${home.country} highlighted, routes from ${home.city} to every visited place, wishlist countries outlined.`;
const sizes = "(min-width: 1100px) 720px, 92vw";
const widths = [360, 540, 720, 1080, 1440];
---

<div class="globe-stage relative mx-auto aspect-square w-full max-w-[720px]" data-globe-stage>
  <span class="globe-poster">
    <ThemePicture
      day={posterDay}
      night={posterNight}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading="eager"
      fetchpriority="high"
    />
  </span>
  <canvas class="globe-canvas" aria-hidden="true"></canvas>
  <div class="globe-tip mono" aria-hidden="true" hidden></div>
</div>

<style>
  .globe-poster,
  .globe-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .globe-poster :global(picture) {
    display: contents;
  }
  .globe-poster :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .globe-canvas {
    display: block;
    opacity: 0;
    cursor: grab;
    touch-action: pan-y;
    transition: opacity 0.4s ease;
  }
  .globe-canvas:active {
    cursor: grabbing;
  }
  .globe-stage[data-live] .globe-canvas {
    opacity: 1;
  }
  .globe-stage[data-live-settled] .globe-poster {
    visibility: hidden;
  }
  .globe-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: var(--face);
    color: var(--marking);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
  }
</style>

<script>
  import type { GlobeHandle } from "@/scripts/globe3d";

  let handle: GlobeHandle | undefined;

  function hasWebGL(): boolean {
    try {
      const c = document.createElement("canvas");
      const gl = (c.getContext("webgl2") || c.getContext("webgl")) as WebGLRenderingContext | null;
      gl?.getExtension("WEBGL_lose_context")?.loseContext();
      return Boolean(gl);
    } catch {
      return false;
    }
  }
  function whenIdle(cb: () => void) {
    if ("requestIdleCallback" in window) window.requestIdleCallback(cb, { timeout: 2500 });
    else setTimeout(cb, 300);
  }
  /** Large screens with a mouse: on idle. Phones / touch: on the first interaction. */
  function whenReady(cb: () => void) {
    if (!window.matchMedia("(pointer: coarse), (max-width: 767px)").matches) return whenIdle(cb);
    const events = ["pointerdown", "scroll", "keydown", "wheel"] as const;
    const go = () => {
      events.forEach((e) => window.removeEventListener(e, go));
      whenIdle(cb);
    };
    events.forEach((e) => window.addEventListener(e, go, { once: true, passive: true }));
  }

  async function start(stage: HTMLElement, capture?: { dpr: number }) {
    const canvas = stage.querySelector<HTMLCanvasElement>(".globe-canvas");
    const tip = stage.querySelector<HTMLElement>(".globe-tip");
    const section = stage.closest<HTMLElement>("[data-adventures]");
    if (!canvas) return;
    // Probe WebGL only now; without it, swap to the flat map.
    if (!capture && !hasWebGL()) {
      if (section) section.dataset.globe = "off";
      return;
    }
    try {
      const { mountGlobe } = await import("@/scripts/globe3d");
      if (!stage.isConnected) return;
      handle = await mountGlobe(canvas, {
        capture,
        onPick: (country) =>
          section?.dispatchEvent(new CustomEvent("adventure:pick", { detail: { country } })),
        onHover: (name, x, y) => {
          if (!tip) return;
          tip.hidden = !name;
          if (name) {
            tip.textContent = name;
            tip.style.left = `${x}px`;
            tip.style.top = `${y}px`;
          }
        },
        onFirstFrame: () => {
          stage.dataset.live = "";
          window.setTimeout(() => (stage.dataset.liveSettled = ""), 500);
          if (capture) (window as unknown as { __globeReady?: boolean }).__globeReady = true;
        },
      });
    } catch (err) {
      console.warn("[globe3d] staying on the poster:", err);
    }
  }

  function init() {
    const stage = document.querySelector<HTMLElement>("[data-globe-stage]");
    if (!stage || stage.dataset.bound) return;
    stage.dataset.bound = "true";
    const section = stage.closest<HTMLElement>("[data-adventures]");

    const params = new URLSearchParams(window.location.search);
    if (params.has("globe-capture")) {
      void start(stage, { dpr: Number(params.get("globe-capture")) || 2 });
      return;
    }
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    section?.addEventListener("adventure:select", (e: Event) => {
      const { lat, lng } = (e as CustomEvent<{ lat?: number; lng?: number }>).detail ?? {};
      if (typeof lat === "number" && typeof lng === "number" && !Number.isNaN(lat))
        handle?.focus(lat, lng);
    });
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      whenReady(() => void start(stage));
    });
    io.observe(stage);
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    handle?.dispose();
    handle = undefined;
  });
</script>
