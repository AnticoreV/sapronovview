---
/**
 * ProfileCard — "Who I am" in one surface card (approved artboard): a studio
 * portrait beside the heading, the current focus and mono fields. The same studio photo
 * in both themes. It is cropped to the 216×270 frame at build (sharp, from the top) and
 * served as AVIF (q70) or WebP (q82) at 1x, 2x and 3x, so every screen gets sharp
 * pixels and nothing is scaled or cropped in the browser. With `switcher` (/about) a
 * segmented control flips between the four portraits (pure CSS: radios + :has()).
 */
import { getImage } from "astro:assets";
import { siteCopy } from "@config";
import { portraitById, portraits, type Portrait } from "@lib/portraits";
import { i18n } from "@/i18n";

interface Props {
  /** Portrait shown first (the turtleneck on the homepage and /about). */
  initial?: Portrait["id"];
  switcher?: boolean;
  /** Render "Engineer and founder." as a heading (off on /about, where it is the h1). */
  heading?: false | 2 | 3;
  /** Load the first portrait eagerly (when the card is above the fold). */
  eager?: boolean;
  class?: string;
}
const {
  initial = "turtleneck",
  switcher = false,
  heading = 2,
  eager = false,
  class: className,
} = Astro.props;
const first = portraitById(initial);
const list = switcher ? [first, ...portraits.filter((p) => p.id !== first.id)] : [first];

// The frame is 216×270 CSS px (4:5); crop to it at build, from the top (the face).
const FRAME = { width: 216, height: 270 };
// layout "none": a fixed frame, so the 1x/2x/3x densities (not the site-wide responsive
// widths) decide the files.
const crop = {
  ...FRAME,
  densities: [1, 2, 3],
  fit: "cover" as const,
  position: "top",
  layout: "none" as const,
};
const shots = await Promise.all(
  list.map(async (p) => {
    const [avif, webp, fallback] = await Promise.all([
      getImage({ src: p.photo, ...crop, format: "avif", quality: 70 }),
      getImage({ src: p.photo, ...crop, format: "webp", quality: 82 }),
      getImage({
        src: p.photo,
        width: 432,
        height: 540,
        fit: "cover",
        position: "top",
        layout: "none",
        format: "jpg",
        quality: 82,
      }),
    ]);
    return { p, avif, webp, fallback };
  }),
);
const { locale, t } = i18n(Astro);
const copy = siteCopy[locale];
const fields = [
  { k: t("who.basedIn"), v: copy.basedIn },
  { k: t("who.role"), v: t("who.roleValue") },
  { k: t("who.languages"), v: copy.languages.map((l) => l.code).join(" · ") },
  { k: t("who.experience"), v: copy.experienceSummary },
];
const Heading = heading === 3 ? "h3" : "h2";
---

<div
  class:list={["profile card flex flex-wrap gap-7 p-7", switcher && "profile--switch", className]}
>
  <div class="profile__portrait relative shrink-0">
    {shots.map(({ p, avif, webp, fallback }, i) => (
      <div class="profile__shot" data-portrait={p.id} data-default={i === 0 ? "" : undefined}>
        <picture>
          <source type="image/avif" srcset={avif.srcSet.attribute} />
          <source type="image/webp" srcset={webp.srcSet.attribute} />
          <img
            src={fallback.src}
            alt={p.alt[locale]}
            width={FRAME.width}
            height={FRAME.height}
            loading={eager && i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </picture>
      </div>
    ))}
  </div>
  <div class="flex min-w-0 flex-[1_1_280px] flex-col gap-5">
    <div class="flex flex-col gap-1.5">
      <span class="label text-ink-muted">{t("who.label")}</span>
      {heading !== false && <Heading class="display text-heading">{t("who.heading")}</Heading>}
      <p class="text-ink-muted">{t("who.now", { focus: copy.currentFocus })}</p>
    </div>
    <dl class="grid grid-cols-[repeat(auto-fit,minmax(min(150px,100%),1fr))] content-start gap-x-6 gap-y-3.5">
      {fields.map((f) => (
        <div>
          <dt class="mono text-[12px] text-ink-muted">{f.k}</dt>
          <dd class="mt-0.5 font-semibold">{f.v}</dd>
        </div>
      ))}
      <div>
        <dt class="mono text-[12px] text-ink-muted">{t("who.status")}</dt>
        <dd class="mt-0.5 font-semibold text-ok-ink">
          <span aria-hidden="true">● </span>
          {t("status.openLabel")}
        </dd>
      </div>
    </dl>
    {switcher && (
      <fieldset class="m-0 border-0 p-0">
        <legend class="label text-ink-muted">{t("who.portrait")}</legend>
        <div class="mt-2.5 inline-flex flex-wrap gap-1 rounded-md bg-surface-sunken p-1">
          {list.map((p, i) => (
            <label class="segment">
              <input
                type="radio"
                name="profile-portrait"
                value={p.id}
                checked={i === 0}
                class="sr-only"
              />
              <span class="segment__label">{p.short[locale]}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}
  </div>
</div>

<style>
  .profile__portrait {
    flex: 0 0 216px;
    width: 216px;
    height: 270px;
  }
  .profile__shot {
    position: absolute;
    inset: 0;
    display: none;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
  }
  .profile__shot[data-default] {
    display: block;
  }
  .profile__shot :global(picture) {
    display: contents;
  }
  .profile__shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Segmented portrait switch (/about). */
  .profile--switch:has(input:checked) .profile__shot {
    display: none;
  }
  .profile--switch:has(input[value="turtleneck"]:checked) [data-portrait="turtleneck"],
  .profile--switch:has(input[value="green"]:checked) [data-portrait="green"],
  .profile--switch:has(input[value="black"]:checked) [data-portrait="black"],
  .profile--switch:has(input[value="white"]:checked) [data-portrait="white"] {
    display: block;
  }
  .segment {
    position: relative;
    cursor: pointer;
  }
  .segment__label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    font-size: 15px;
    font-weight: 600;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .segment:hover .segment__label {
    color: var(--ink);
  }
  .segment input:checked + .segment__label {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--line);
  }
  .segment input:focus-visible + .segment__label {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
