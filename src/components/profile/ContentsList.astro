---
/**
 * ContentsList: "Before you hire, invest or partner", the homepage contents as rows
 * (Products I build … Get in touch), each with an arrow and linking to its section.
 */
import Arrow from "@components/ui/Arrow.astro";
import { contents as contentsFor } from "@data/home";
import { i18n } from "@/i18n";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { locale, t } = i18n(Astro);
const contents = contentsFor(locale);
---

<nav aria-label={t("contents.label")} class:list={["card flex flex-col gap-1 p-7", className]}>
  <p class="label pb-2 text-ink-muted">{t("contents.title")}</p>
  <ol class="flex flex-col">
    {contents.map((item, i) => {
      const last = i === contents.length - 1;
      return (
        <li>
          <a
            href={item.href}
            class:list={[
              "contents-link flex min-h-11 items-center justify-between gap-4 font-semibold no-underline",
              !last && "border-b border-line",
              last && "text-accent",
            ]}
          >
            <span>{item.label}</span>
            <Arrow weight="bold" />
          </a>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .contents-link:hover {
    color: var(--accent);
  }
</style>
