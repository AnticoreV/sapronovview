---
/**
 * InstrumentModule — a dark instrument face set into the panel, used for the
 * products (Ownira, Apexline) and featured work. The whole module is one link.
 * Hover / focus: a cyan ring outside the bezel — no lift, no scale.
 */
import StatusLamp from "@components/ui/StatusLamp.astro";
import PlaceholderBadge from "@components/ui/PlaceholderBadge.astro";
import { shortCompany, shown, statusLabels, type Project } from "@lib/content";

interface Props {
  project: Project;
  /** Heading level of the product name. */
  level?: 2 | 3;
  /** "lg" = product module (display name), "md" = featured work. */
  size?: "lg" | "md";
}
const { project, level = 3, size = "lg" } = Astro.props;
const { data } = project;
const status = statusLabels[data.status];
const Name = level === 2 ? "h2" : "h3";
const org = shown(data.organization);
const source = [shown(data.domain) ?? (org ? shortCompany(org) : data.title), shown(data.role)]
  .filter(Boolean)
  .join(" · ");
const text = data.summary ?? data.description;
---

<a
  href={`/projects/${project.id}`}
  class="instrument face face-bezel flex h-full w-full flex-col gap-[18px] p-7 no-underline sm:p-8"
>
  <div class="placard flex flex-wrap justify-between gap-3">
    <span class="text-marking-muted">{source}</span>
    <StatusLamp label={status.label} tone={status.tone} />
  </div>
  <Name
    class:list={[
      "display",
      size === "lg" ? "text-display-m" : "text-[clamp(1.75rem,2.6vw,2.25rem)] leading-[1.05]",
    ]}
  >
    {data.title}
  </Name>
  {data.tagline && <p class="text-[21px] leading-snug font-semibold text-select">{data.tagline}</p>}
  <p class="max-w-[480px] text-marking-muted">{text}</p>
  {data.placeholder && <PlaceholderBadge />}
</a>

<style>
  .instrument {
    transition: box-shadow 0.15s ease;
  }
  .instrument:hover {
    box-shadow:
      var(--shadow-face),
      0 0 0 2px var(--select);
  }
</style>
