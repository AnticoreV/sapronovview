---
/**
 * Category filter for the project archive. Works without JavaScript (everything
 * visible); a small script hides non-matching items when a filter is chosen and
 * mirrors the choice in the URL hash.
 */
import { categoryLabels, type Project } from "@lib/content";

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const counts = new Map<string, number>();
for (const p of projects) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const categories = (Object.keys(categoryLabels) as Array<keyof typeof categoryLabels>).filter((c) =>
  counts.has(c),
);
---

{categories.length > 1 && (
  <div
    class="flex flex-wrap items-center gap-2"
    role="group"
    aria-label="Filter projects by category"
    data-project-filters
  >
    <button type="button" data-filter="all" aria-pressed="true" class="filter">
      All <span class="tabular opacity-70">{projects.length}</span>
    </button>
    {categories.map((c) => (
      <button type="button" data-filter={c} aria-pressed="false" class="filter">
        {categoryLabels[c]} <span class="tabular opacity-70">{counts.get(c)}</span>
      </button>
    ))}
    <p class="sr-only" aria-live="polite" data-filter-status />
  </div>
)}

<style>
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-inline: 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .filter:hover {
    border-color: var(--line-strong);
  }
  .filter[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
</style>

<script>
  function setupProjectFilters() {
    const root = document.querySelector<HTMLElement>("[data-project-filters]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";

    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const status = root.querySelector<HTMLElement>("[data-filter-status]");
    const items = [...document.querySelectorAll<HTMLElement>("[data-category]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-project-group]")];

    const apply = (filter: string) => {
      let count = 0;
      items.forEach((item) => {
        const match = filter === "all" || item.dataset.category === filter;
        item.hidden = !match;
        if (match) count++;
      });
      groups.forEach((g) => {
        g.hidden = !g.querySelector("[data-category]:not([hidden])");
      });
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === filter)));
      if (status) status.textContent = `${count} project${count === 1 ? "" : "s"} shown`;
    };

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const filter = b.dataset.filter ?? "all";
        history.replaceState(null, "", filter === "all" ? location.pathname : `#${filter}`);
        apply(filter);
      }),
    );

    const initial = location.hash.slice(1);
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
  }
  document.addEventListener("astro:page-load", setupProjectFilters);
</script>
