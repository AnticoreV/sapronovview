---
/**
 * ProductModule — the wide product card from the approved artboard (Ownira), also
 * used for featured client work on /projects (components.md: "featured client work
 * (no facts)"). Own product: domain · role, status pill, name, tagline, description,
 * "Read the case →" and a facts list (STATUS, FOR, MY ROLE, WEB — only real values).
 * Client work: organisation, status pill, name, description, "Read the case →".
 * The whole card is one link; hover lifts it.
 */
import StatusBadge from "@components/ui/StatusBadge.astro";
import PlaceholderBadge from "@components/ui/PlaceholderBadge.astro";
import { shortCompany, shown, shownAll, statusLabels, type Project } from "@lib/content";

interface Props {
  project: Project;
  /** Heading level of the product name. */
  level?: 2 | 3;
  /** "lg" = product (display-m name), "md" = featured client work. */
  size?: "lg" | "md";
}
const { project, level = 3, size = "lg" } = Astro.props;
const { data } = project;
const status = statusLabels[data.status];
const Name = level === 2 ? "h2" : "h3";
const isProduct = size === "lg";
const org = shown(data.organization);
const source = isProduct
  ? [shown(data.domain) ?? (org ? shortCompany(org) : data.title), shown(data.role)]
      .filter(Boolean)
      .join(" · ")
  : org
    ? shortCompany(org)
    : data.title;
const text = data.summary ?? data.description;
const facts = isProduct
  ? [
      { label: "Status", value: status.label },
      ...shownAll(data.facts, (f) => `${f.label} ${f.value}`),
      shown(data.domain) && { label: "Web", value: shown(data.domain)! },
    ].filter((f): f is { label: string; value: string } => Boolean(f && f.value))
  : [];
---

<a
  href={`/projects/${project.id}`}
  class="product card lift flex h-full w-full flex-wrap gap-x-12 gap-y-8 p-[clamp(24px,3vw,40px)] no-underline"
>
  <div class="flex flex-[1_1_420px] flex-col gap-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="mono text-[12px] font-medium text-ink-muted uppercase">{source}</span>
      <StatusBadge label={status.label} tone={status.tone} />
    </div>
    <Name
      class:list={[
        "display tracking-[-0.04em]",
        size === "lg" ? "text-display-m" : "text-[clamp(30px,3vw,40px)] leading-[1.05]",
      ]}
    >
      {data.title}
    </Name>
    {data.tagline && (
      <p class="text-[clamp(21px,2vw,26px)] leading-[1.3] font-semibold text-accent">
        {data.tagline}
      </p>
    )}
    <p class="max-w-[560px] text-ink-muted">{text}</p>
    <span class="read-more mt-auto pt-2 font-semibold text-accent">
      Read the case <span aria-hidden="true">→</span>
    </span>
    {data.placeholder && <PlaceholderBadge />}
  </div>
  {facts.length > 0 && (
    <dl class="m-0 grid flex-[1_1_320px] grid-cols-[auto_1fr] content-start gap-x-6 gap-y-3.5 border-t border-line pt-3.5">
      {facts.map((f) => (
        <>
          <dt class="mono pt-0.5 text-[12px] font-medium text-ink-muted uppercase">{f.label}</dt>
          <dd class="m-0">{f.value}</dd>
        </>
      ))}
    </dl>
  )}
</a>

<style>
  .product:hover {
    color: var(--ink);
  }
  .read-more {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .product:hover .read-more {
    text-decoration-thickness: 2px;
  }
</style>
