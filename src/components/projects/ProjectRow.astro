---
/** A project as a kneeboard row: title, one-line description, mono meta. */
import PlaceholderBadge from "@components/ui/PlaceholderBadge.astro";
import { categoryLabels, shortCompany, shown, statusLabels, type Project } from "@lib/content";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { data } = project;
const org = shown(data.organization);
const meta = [
  org ? shortCompany(org) : categoryLabels[data.category],
  shown(data.timeframe),
  statusLabels[data.status].label,
]
  .filter(Boolean)
  .join(" · ");
---

<a
  href={`/projects/${project.id}`}
  class="row grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-x-8 gap-y-2 border-b border-panel-edge py-6 no-underline"
>
  <span class="text-heading font-bold">{data.title}</span>
  <span class="text-ink-muted">{data.description}</span>
  <span class="mono text-xs leading-relaxed text-ink-muted uppercase">
    {meta}
    <br />
    {data.technologies.slice(0, 4).join(" · ")}
    {data.placeholder && <PlaceholderBadge />}
  </span>
</a>

<style>
  .row:hover span:first-child {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
</style>
