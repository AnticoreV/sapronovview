---
import TechBadge from "@components/ui/TechBadge.astro";
import { i18n } from "@/i18n";

interface Props {
  tags: Array<{ tag: string; count?: number }>;
  active?: string;
  class?: string;
}
const { tags, active, class: className } = Astro.props;
const { t, l } = i18n(Astro);
---

{tags.length > 0 && (
  <nav aria-label={t("writing.tagsLabel")} class:list={["flex flex-wrap gap-2", className]}>
    <TechBadge label={t("filters.all")} href={l("/writing")} current={!active} />
    {tags.map(({ tag, count }) => (
      <TechBadge
        label={count ? `${tag} · ${count}` : tag}
        href={l(`/writing/tags/${tag}`)}
        current={active === tag}
      />
    ))}
  </nav>
)}
