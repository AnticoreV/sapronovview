---
import TechBadge from "@components/ui/TechBadge.astro";

interface Props {
  tags: Array<{ tag: string; count?: number }>;
  active?: string;
  class?: string;
}
const { tags, active, class: className } = Astro.props;
---

{tags.length > 0 && (
  <nav aria-label="Tags" class:list={["flex flex-wrap gap-2", className]}>
    <TechBadge label="All" href="/writing" current={!active} />
    {tags.map(({ tag, count }) => (
      <TechBadge
        label={count ? `${tag} · ${count}` : tag}
        href={`/writing/tags/${tag}`}
        current={active === tag}
      />
    ))}
  </nav>
)}
