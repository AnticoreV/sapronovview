---
/**
 * Case study on a kneeboard sheet: eyebrow (type · organisation · years), title,
 * readouts for any real numbers, body, technologies as mono chips, links.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PlaceholderBadge from "@components/ui/PlaceholderBadge.astro";
import Readout from "@components/ui/Readout.astro";
import StatusLamp from "@components/ui/StatusLamp.astro";
import TechBadge from "@components/ui/TechBadge.astro";
import ProjectRow from "@components/projects/ProjectRow.astro";
import JsonLd from "@components/seo/JsonLd.astro";
import { categoryLabels, shortCompany, shown, statusLabels, type Project } from "@lib/content";
import { readoutsFor } from "@data/readouts";
import { siteConfig } from "@config";
import { cleanPath } from "@lib/utils";

interface Props {
  project: Project;
  related: Project[];
}
const { project, related } = Astro.props;
const { data } = project;
const status = statusLabels[data.status];
const site = Astro.site ?? new URL("http://localhost:4321");
const isProduct = Boolean(data.tagline);
const org = shown(data.organization);
const eyebrow = [
  isProduct
    ? "Product"
    : data.category === "professional"
      ? "Case study"
      : categoryLabels[data.category],
  org && org !== data.title ? shortCompany(org) : undefined,
  shown(data.timeframe)?.replace(/\s+—\s+/g, "–"),
]
  .filter(Boolean)
  .join(" · ");
const readouts = readoutsFor(project.id);
const role = shown(data.role);
const links = [
  data.website && { label: "Live site", href: data.website },
  data.github && { label: "GitHub", href: data.github },
  ...data.links,
].filter(Boolean) as Array<{ label: string; href: string }>;
const topic = isProduct ? "investing" : "hiring";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: data.title,
  description: data.description,
  url: new URL(cleanPath(Astro.url.pathname), site).toString(),
  author: { "@type": "Person", name: siteConfig.name, url: site.origin },
  keywords: data.technologies.join(", "),
  ...(data.github ? { codeRepository: data.github } : {}),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={data.cover ? data.cover.src : undefined}
  imageAlt={data.coverAlt}
>
  <article class="band pt-8 pb-16 md:pb-24">
    <div class="shell">
      <Breadcrumbs items={[{ label: "Projects", href: "/projects" }, { label: data.title }]} />
    </div>
    <div class="sheet mx-auto mt-6 max-w-[848px] px-[clamp(16px,6vw,64px)] py-10 md:py-16">
      <p class="label flex flex-wrap items-center gap-x-4 gap-y-2 text-ink-muted">
        <span>{eyebrow}</span>
        <StatusLamp label={status.label} tone={status.tone} on="panel" />
        {data.placeholder && <PlaceholderBadge />}
      </p>
      <h1 class="display mt-4 text-[clamp(2.25rem,5vw,3.5rem)] leading-[0.98]">{data.title}</h1>
      {data.tagline && <p class="mt-4 text-title font-semibold">{data.tagline}</p>}
      <p class="mt-4 text-body-l">{data.description}</p>
      {role && (
        <p class="mono mt-5 text-label text-ink-muted uppercase">
          Role · <span class="font-semibold text-ink">{role}</span>
        </p>
      )}
      {readouts.length > 0 && (
        <ul
          class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] gap-3"
          aria-label="Readouts"
        >
          {readouts.map((r) => (
            <li class="flex">
              <Readout readout={r} class="w-full" />
            </li>
          ))}
        </ul>
      )}
      <div class="prose-kneeboard mt-10" data-project-body>
        <slot />
      </div>
      {data.technologies.length > 0 && (
        <div class="mt-10 border-t border-panel-edge pt-6">
          <h2 class="label text-ink-muted">Stack</h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {data.technologies.map((t) => (
              <li>
                <TechBadge label={t} />
              </li>
            ))}
          </ul>
        </div>
      )}
      {links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          {links.map((l) => (
            <a
              href={l.href}
              class="link-ghost inline-flex min-h-11 items-center"
              rel="noopener noreferrer"
            >
              {l.label}
              <span aria-hidden="true">&nbsp;↗</span>
            </a>
          ))}
        </div>
      )}
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href={`/contact?topic=${topic}`} class="btn btn-primary">
          {isProduct ? "Let's talk" : "Discuss a similar project"}
        </a>
        <a href="/projects" class="btn btn-secondary">
          All projects
        </a>
      </div>
    </div>

    {related.length > 0 && (
      <section class="shell mt-16" aria-labelledby="related-heading">
        <h2 id="related-heading" class="display text-[clamp(1.75rem,3vw,2.5rem)]">
          More projects
        </h2>
        <ul class="mt-6 border-t-2 border-ink">
          {related.map((p) => (
            <li>
              <ProjectRow project={p} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
  <JsonLd data={jsonLd} />
</BaseLayout>
