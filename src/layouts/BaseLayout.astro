---
/**
 * Root layout: <head> (fonts, SEO, theme bootstrap), the sticky site header, the
 * accent contact panel that closes every page, footer, skip link and view transitions.
 * Content is static: the hero 3D scene is the only animated moment.
 */
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import SEO, { type Props as SEOProps } from "@components/seo/SEO.astro";
import SiteHeader from "@components/layout/SiteHeader.astro";
import Footer from "@components/layout/Footer.astro";
import ContactPanel from "@components/layout/ContactPanel.astro";
import { i18n, type Locale } from "@/i18n";
import "@styles/global.css";

interface Props extends SEOProps {
  /** Extra classes for <main>. */
  class?: string;
  /** Every page ends with the contact panel; /contact renders it itself as the page head. */
  contactPanel?: boolean;
  /** Language-switch targets when they differ from "this page in the other language". */
  langPaths?: Partial<Record<Locale, string>>;
}
const { class: className, contactPanel = true, langPaths, ...seo } = Astro.props;
const { locale, t } = i18n(Astro);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbf3ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1218" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Theme bootstrap: runs before paint so there is no flash of the wrong theme.
        Stored choice wins; otherwise the OS preference decides. */}
    <script is:inline>
      (() => {
        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch {
            /* storage unavailable */
          }
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
        // Without a stored choice, follow OS theme changes live (pictures, 3D and the
        // toggle listen to the class / the "themechange" event).
        if (!window.__themeFollowsOs) {
          window.__themeFollowsOs = true;
          window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
            let stored = null;
            try {
              stored = localStorage.getItem("theme");
            } catch {
              /* storage unavailable */
            }
            if (stored) return;
            apply();
            document.dispatchEvent(
              new CustomEvent("themechange", {
                detail: { dark: document.documentElement.classList.contains("dark") },
              }),
            );
          });
        }
      })();
    </script>
    {/* Homepage opened or reloaded: the plain address starts at the top, /#expertise at
        that section. The view-transitions router (and the browser) would otherwise restore
        the last scroll position on reload, so the saved position is dropped before the
        router runs and the browser's own restoring is off. Back and forward still return
        to where you were. */}
    {Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/\/$/, "") ===
      (locale === "cs" ? "/cs" : "") && <script is:inline>
      (() => {
        // Full page loads only, not when the router swaps this page in.
        if (document.readyState !== "loading") return;
        const nav = performance.getEntriesByType("navigation")[0];
        if (nav && nav.type === "back_forward") return;
        history.scrollRestoration = "manual";
        if (history.state) {
          const { scrollX, scrollY, ...state } = history.state;
          history.replaceState(state, "");
        }
        // Chrome and Firefox skip the #hash jump on a reload; jump without smooth scroll.
        const id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        document.addEventListener(
          "DOMContentLoaded",
          () => {
            const target = document.getElementById(id);
            if (!target) return;
            const root = document.documentElement;
            root.style.scrollBehavior = "auto";
            target.scrollIntoView();
            root.style.scrollBehavior = "";
          },
          { once: true },
        );
      })();
    </script>}
    {/* Language: English pages (no /cs prefix) send a first-time visitor whose browser
        prefers Czech to the same page under /cs — before paint, keeping ?query and #hash.
        A stored choice from the EN | CS switch always wins; Czech pages never redirect;
        bots, crawlers and automated browsers are never redirected. */}
    {locale === "en" && <script is:inline>
      (() => {
        try {
          if (navigator.webdriver) return;
          if (
            /bot|crawl|spider|lighthouse|slurp|facebookexternalhit|preview/i.test(
              navigator.userAgent,
            )
          )
            return;
          let lang = null;
          try {
            lang = localStorage.getItem("lang");
          } catch {
            /* storage unavailable */
          }
          if (lang !== "cs" && lang !== "en") {
            const prefs =
              navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || ""];
            const first = prefs
              .map((l) => String(l).toLowerCase())
              .find((l) => /^(cs|en)(-|$)/.test(l));
            lang = first && first.startsWith("cs") ? "cs" : "en";
          }
          if (lang !== "cs") return;
          const path = location.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
          location.replace((path === "/" ? "/cs" : "/cs" + path) + location.search + location.hash);
        } catch {
          /* stay on the English page */
        }
      })();
    </script>}
    {/* Latin subsets are preloaded (mono: the 500 labels only); latin-ext (Czech
        diacritics) is preloaded on Czech pages and loads on demand on English ones; the
        other mono weights load on demand. */}
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-newsreader-ext" preload={locale === "cs"} />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-schibsted-ext" preload={locale === "cs"} />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: 500 }]} />
    <Font
      cssVariable="--font-plex-mono-ext"
      preload={locale === "cs" ? [{ weight: 500 }] : false}
    />

    <SEO {...seo} />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-5 focus:py-2.5"
    >
      {t("skip")}
    </a>
    <SiteHeader langPaths={langPaths} />
    <main id="main" class:list={["flex-1 outline-none", className]} tabindex="-1">
      <slot />
    </main>
    {contactPanel && <ContactPanel />}
    <Footer />
  </body>
</html>
