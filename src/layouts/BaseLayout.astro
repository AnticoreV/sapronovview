---
/**
 * Root layout: <head> (fonts, SEO, theme bootstrap), the sticky site header, the
 * accent contact panel that closes every page, footer, skip link and view transitions.
 * Content is static: the hero 3D scene is the only animated moment.
 */
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import SEO, { type Props as SEOProps } from "@components/seo/SEO.astro";
import SiteHeader from "@components/layout/SiteHeader.astro";
import Footer from "@components/layout/Footer.astro";
import ContactPanel from "@components/layout/ContactPanel.astro";
import { i18n, type Locale } from "@/i18n";
import "@styles/global.css";

interface Props extends SEOProps {
  /** Extra classes for <main>. */
  class?: string;
  /** Every page ends with the contact panel; /contact renders it itself as the page head. */
  contactPanel?: boolean;
  /** Language-switch targets when they differ from "this page in the other language". */
  langPaths?: Partial<Record<Locale, string>>;
}
const { class: className, contactPanel = true, langPaths, ...seo } = Astro.props;
const { locale, t } = i18n(Astro);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#eef1f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Theme bootstrap: runs before paint so there is no flash of the wrong theme.
        Stored choice wins; otherwise the OS preference decides. */}
    <script is:inline>
      (() => {
        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch {
            /* storage unavailable */
          }
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
        // Without a stored choice, follow OS theme changes live (pictures, 3D and the
        // toggle listen to the class / the "themechange" event).
        if (!window.__themeFollowsOs) {
          window.__themeFollowsOs = true;
          window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
            let stored = null;
            try {
              stored = localStorage.getItem("theme");
            } catch {
              /* storage unavailable */
            }
            if (stored) return;
            apply();
            document.dispatchEvent(
              new CustomEvent("themechange", {
                detail: { dark: document.documentElement.classList.contains("dark") },
              }),
            );
          });
        }
      })();
    </script>
    {/* Homepage sections without #hash URLs: the address bar never keeps #expertise and
        friends, so a copied, shared or reopened link starts at the top. Opened with a hash
        from elsewhere (typed, pasted, another site), the hash is dropped before the browser
        jumps; from one of my pages (a link opened in a new tab) it still lands on the
        section. Links within the homepage scroll and move focus without a hash; the header
        nav from a subpage lands on the section, then the hash is dropped. Runs before the
        language redirect, so /#expertise → /cs, not /cs#expertise. */}
    <script is:inline>
      (() => {
        const isHome = (path) => /^\/(cs\/?)?$/.test(path.replace(/(index)?\.html$/, ""));
        const clean = () =>
          history.replaceState(history.state, "", location.pathname + location.search);
        if (location.hash && isHome(location.pathname)) {
          const id = decodeURIComponent(location.hash.slice(1));
          let fromMyPages = false;
          try {
            fromMyPages = new URL(document.referrer).origin === location.origin;
          } catch {
            /* no referrer */
          }
          clean();
          if (fromMyPages)
            document.addEventListener(
              "DOMContentLoaded",
              () => document.getElementById(id)?.scrollIntoView(),
              {
                once: true,
              },
            );
        }
        if (window.__sectionLinks) return;
        window.__sectionLinks = true;
        document.addEventListener(
          "click",
          (ev) => {
            if (
              ev.defaultPrevented ||
              ev.button !== 0 ||
              ev.metaKey ||
              ev.ctrlKey ||
              ev.shiftKey ||
              ev.altKey
            )
              return;
            const link = ev.target instanceof Element ? ev.target.closest("a[href]") : null;
            if (!link || (link.target && link.target !== "_self") || link.hasAttribute("download"))
              return;
            const url = new URL(link.href);
            if (!url.hash || url.origin !== location.origin || url.pathname !== location.pathname)
              return;
            if (url.search !== location.search || !isHome(location.pathname)) return;
            const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
            if (!target || target.id === "main") return; // the skip link keeps its native jump
            ev.preventDefault();
            // After the other click handlers (the phone menu closes and hands focus back).
            requestAnimationFrame(() => {
              target.scrollIntoView(); // smooth unless reduced motion; honours scroll-padding-top
              if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
              target.focus({ preventScroll: true }); // Tab continues inside the section
            });
          },
          true,
        );
        document.addEventListener("astro:after-swap", () => {
          if (location.hash && isHome(location.pathname)) clean();
        });
      })();
    </script>
    {/* Language: English pages (no /cs prefix) send a first-time visitor whose browser
        prefers Czech to the same page under /cs — before paint, keeping ?query and #hash.
        A stored choice from the EN | CS switch always wins; Czech pages never redirect;
        bots, crawlers and automated browsers are never redirected. */}
    {locale === "en" && <script is:inline>
      (() => {
        try {
          if (navigator.webdriver) return;
          if (
            /bot|crawl|spider|lighthouse|slurp|facebookexternalhit|preview/i.test(
              navigator.userAgent,
            )
          )
            return;
          let lang = null;
          try {
            lang = localStorage.getItem("lang");
          } catch {
            /* storage unavailable */
          }
          if (lang !== "cs" && lang !== "en") {
            const prefs =
              navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || ""];
            const first = prefs
              .map((l) => String(l).toLowerCase())
              .find((l) => /^(cs|en)(-|$)/.test(l));
            lang = first && first.startsWith("cs") ? "cs" : "en";
          }
          if (lang !== "cs") return;
          const path = location.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
          location.replace((path === "/" ? "/cs" : "/cs" + path) + location.search + location.hash);
        } catch {
          /* stay on the English page */
        }
      })();
    </script>}
    {/* Latin subsets are preloaded (mono: the 500 labels only); latin-ext (Czech
        diacritics) is preloaded on Czech pages and loads on demand on English ones; the
        other mono weights load on demand. */}
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-newsreader-ext" preload={locale === "cs"} />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-schibsted-ext" preload={locale === "cs"} />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: 500 }]} />
    <Font
      cssVariable="--font-plex-mono-ext"
      preload={locale === "cs" ? [{ weight: 500 }] : false}
    />

    <SEO {...seo} />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-5 focus:py-2.5"
    >
      {t("skip")}
    </a>
    <SiteHeader langPaths={langPaths} />
    <main id="main" class:list={["flex-1 outline-none", className]} tabindex="-1">
      <slot />
    </main>
    {contactPanel && <ContactPanel />}
    <Footer />
  </body>
</html>
