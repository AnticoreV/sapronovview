---
/** Article on a Sheet (surface, 68ch); code blocks use the github-light / github-dark-dimmed pair. */
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import Arrow from "@components/ui/Arrow.astro";
import FormattedDate from "@components/ui/FormattedDate.astro";
import PlaceholderBadge from "@components/ui/PlaceholderBadge.astro";
import TechBadge from "@components/ui/TechBadge.astro";
import ArticleRow from "@components/writing/ArticleRow.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import JsonLd from "@components/seo/JsonLd.astro";
import type { Post } from "@lib/content";
import { cleanPath, readingTime } from "@lib/utils";
import { siteConfig } from "@config";
import { i18n } from "@/i18n";

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
  related: Post[];
}
const { post, prev, next, related } = Astro.props;
const { data } = post;
const { locale, t, l } = i18n(Astro);
// Posts are written in English; on Czech pages the article is marked lang="en".
const postLang = locale === "en" ? undefined : "en";
const { minutes, words } = readingTime(post.body ?? "");
const site = Astro.site ?? new URL("http://localhost:4321");
const url = new URL(cleanPath(Astro.url.pathname), site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { "@type": "Person", name: siteConfig.name, url: site.origin },
  publisher: { "@type": "Person", name: siteConfig.name },
  mainEntityOfPage: url,
  url,
  keywords: data.tags.join(", "),
  wordCount: words,
  ...(data.cover ? { image: new URL(data.cover.src, site).toString() } : {}),
  inLanguage: "en",
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={data.cover ? data.cover.src : undefined}
  imageAlt={data.coverAlt}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  tags={data.tags}
  noindex={data.draft}
>
  <article class="band section-gap pt-8">
    <!-- Same width as the sheet below, so the breadcrumb starts where the sheet does. -->
    <div class="mx-auto max-w-[848px]">
      <Breadcrumbs
        items={[{ label: t("writing.title"), href: "/writing" }, { label: data.title }]}
      />
    </div>
    <div class="sheet mx-auto mt-6 max-w-[848px] px-[clamp(16px,6vw,64px)] py-10 md:py-16">
      <p class="label flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-muted">
        <span>{t("writing.article")}</span>
        <span aria-hidden="true">·</span>
        <FormattedDate
          date={data.pubDate}
          format={{ year: "numeric", month: "short", day: "numeric" }}
        />
        <span aria-hidden="true">·</span>
        <span>{t("writing.minRead", { n: String(minutes) })}</span>
        {data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              {t("writing.updated")} <FormattedDate date={data.updatedDate} />
            </span>
          </>
        )}
        {data.draft && <PlaceholderBadge label="Draft" />}
        {data.placeholder && <PlaceholderBadge label="Sample" />}
      </p>
      <h1 class="display mt-4 text-display-page" lang={postLang}>
        {data.title}
      </h1>
      <p class="mt-4 text-body-l" lang={postLang}>
        {data.description}
      </p>
      {postLang && <p class="mt-3 text-small text-ink-muted">{t("writing.inEnglish")}</p>}
      {data.tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label={t("writing.tagsLabel")}>
          {data.tags.map((tag) => (
            <li>
              <TechBadge label={tag} href={l(`/writing/tags/${tag}`)} />
            </li>
          ))}
        </ul>
      )}
      {data.cover && (
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ""}
          width={1200}
          height={675}
          widths={[600, 900, 1200]}
          sizes="(min-width: 848px) 720px, 100vw"
          loading="eager"
          class="mt-8 aspect-video w-full rounded-md object-cover"
        />
      )}
      <div class="prose-sheet mt-10" lang={postLang}>
        <slot />
      </div>
    </div>

    <nav aria-label={t("writing.adjacent")} class="shell mt-10 grid gap-4 sm:grid-cols-2">
      {prev ? (
        <a href={l(`/writing/${prev.id}`)} class="card lift flex flex-col gap-1 p-5 no-underline">
          <span class="label text-ink-muted">
            <Arrow dir="left" class="mr-[0.4em]" />
            {t("writing.previous")}
          </span>
          <span class="font-semibold" lang={postLang}>
            {prev.data.title}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={l(`/writing/${next.id}`)}
          class="card lift flex flex-col gap-1 p-5 text-right no-underline"
        >
          <span class="label text-ink-muted">
            {t("writing.next")}
            <Arrow class="ml-[0.4em]" />
          </span>
          <span class="font-semibold" lang={postLang}>
            {next.data.title}
          </span>
        </a>
      )}
    </nav>

    {related.length > 0 && (
      <section class="shell mt-16 flex flex-col gap-6" aria-labelledby="related-posts">
        <SectionHeader id="related-posts" title={t("writing.related")} />
        <ul class="flex flex-col gap-3">
          {related.map((p) => (
            <li>
              <ArticleRow post={p} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
  <JsonLd data={jsonLd} />
</BaseLayout>
