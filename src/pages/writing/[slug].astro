---
import { render } from "astro:content";
import ArticleLayout from "@layouts/ArticleLayout.astro";
import { getAdjacentPosts, getPosts, getRelatedPosts } from "@lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...getAdjacentPosts(post, posts), related: getRelatedPosts(post, posts) },
  }));
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout post={post} prev={prev} next={next} related={related}>
  <Content />
</ArticleLayout>
