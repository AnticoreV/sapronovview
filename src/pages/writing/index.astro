---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import ArticleRow from "@components/writing/ArticleRow.astro";
import TagList from "@components/writing/TagList.astro";
import { getAllTags, getPosts } from "@lib/content";

const posts = await getPosts();
const tags = await getAllTags(posts);
---

<BaseLayout
  title="Writing"
  description="Engineering notes on the JVM, identity, delivery and automation — plus the occasional lesson from the cockpit."
>
  <div class="band pt-8 pb-16 md:pt-10 md:pb-24">
    <div class="shell">
      <Breadcrumbs items={[{ label: "Writing" }]} />
      <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="label text-ink-muted">Notes · articles</p>
          <h1 class="display mt-3 text-display-l">Writing</h1>
        </div>
        <a href="/rss.xml" class="link-ghost inline-flex min-h-11 items-center">
          RSS feed
        </a>
      </div>
      <p class="mt-5 max-w-[640px] text-body-l">
        Things I learned the hard way, written down so I don't have to learn them twice.
      </p>
      <TagList tags={tags} class="mt-8" />
      {posts.length > 0 ? (
        <ul class="mt-10 border-b-2 border-ink">
          {posts.map((post) => (
            <li>
              <ArticleRow post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="module mt-10 max-w-[720px] p-6">
          <p class="label text-ink">No entries logged yet</p>
          <p class="mt-2 text-ink-muted">
            New notes will appear here and in the{" "}
            <a href="/rss.xml" class="link-inline text-ink">
              RSS feed
            </a>
            .
          </p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
