---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import AdventuresSection from "@components/adventures/AdventuresSection.astro";
---

<BaseLayout
  title="Adventures"
  description="A paper globe of the countries I've visited, home in Prague and the places still on the list — drag to turn it."
>
  <AdventuresSection class="pt-8 pb-16 md:pt-10 md:pb-24">
    <div slot="before">
      <Breadcrumbs items={[{ label: "Hobbies", href: "/hobbies" }, { label: "Adventures" }]} />
    </div>
  </AdventuresSection>
</BaseLayout>
