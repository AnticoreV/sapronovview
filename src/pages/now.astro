---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import FormattedDate from "@components/ui/FormattedDate.astro";
import { getProjects, shown, shownAll } from "@lib/content";

const [entry] = await getCollection("now");
if (!entry) throw new Error("Add a file to src/content/now/ to populate the Now page.");
const { Content } = await render(entry);
const { data } = entry;
const projects = await getProjects();
const sideProjects = data.sideProjects
  .map((ref) => projects.find((p) => p.id === ref.id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const working = shownAll(data.working);
const learning = shownAll(data.learning);
const reading = shownAll(data.reading, (r) => `${r.title} ${r.author ?? ""} ${r.note ?? ""}`);
const interests = shownAll(data.interests);
const groups = [
  { id: "working", title: "Working on", items: working },
  { id: "learning", title: "Learning", items: learning },
].filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Now"
  description="What I'm working on, learning and reading right now."
  type="profile"
>
  <div class="band pt-8 pb-16 md:pt-10 md:pb-24">
    <div class="shell">
      <Breadcrumbs items={[{ label: "Now" }]} />
    </div>
    <article class="sheet mx-auto mt-6 max-w-[848px] px-[clamp(16px,6vw,64px)] py-10 md:py-16">
      <p class="label flex flex-wrap gap-x-2 text-ink-muted">
        <span>Now</span>
        <span aria-hidden="true">·</span>
        <span>
          Updated{" "}
          <FormattedDate
            date={data.updated}
            format={{ year: "numeric", month: "short", day: "numeric" }}
          />
        </span>
        {shown(data.location) && (
          <>
            <span aria-hidden="true">·</span>
            <span>{data.location}</span>
          </>
        )}
      </p>
      <h1 class="display mt-4 text-[clamp(2.25rem,5vw,3.5rem)] leading-[0.98]">
        What I'm doing now
      </h1>
      <div class="prose-kneeboard mt-6 text-body-l">
        <Content />
      </div>

      <div class="mt-10 flex flex-col gap-8">
        {groups.map((g) => (
          <section aria-labelledby={`now-${g.id}`}>
            <h2 id={`now-${g.id}`} class="label text-ink-muted">
              {g.title}
            </h2>
            <ul class="mt-3 flex flex-col gap-2">
              {g.items.map((item) => (
                <li class="flex gap-3">
                  <span class="mono shrink-0 text-ok-ink" aria-hidden="true">
                    ▸
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
        {reading.length > 0 && (
          <section aria-labelledby="now-reading">
            <h2 id="now-reading" class="label text-ink-muted">
              Reading
            </h2>
            <ul class="mt-3 flex flex-col gap-3">
              {reading.map((r) => (
                <li>
                  <p class="font-semibold">{r.title}</p>
                  {r.author && <p class="text-small text-ink-muted">{r.author}</p>}
                  {r.note && <p class="mt-1 text-small text-ink-muted">{r.note}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
        {sideProjects.length > 0 && (
          <section aria-labelledby="now-projects">
            <h2 id="now-projects" class="label text-ink-muted">
              Projects
            </h2>
            <ul class="mt-3 flex flex-col gap-3">
              {sideProjects.map((p) => (
                <li>
                  <a href={`/projects/${p.id}`} class="link-inline font-semibold">
                    {p.data.title}
                  </a>
                  <p class="text-small text-ink-muted">{p.data.description}</p>
                </li>
              ))}
            </ul>
          </section>
        )}
        {interests.length > 0 && (
          <section aria-labelledby="now-interests">
            <h2 id="now-interests" class="label text-ink-muted">
              Interests
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {interests.map((i) => (
                <li class="chip">{i}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </article>
  </div>
</BaseLayout>
