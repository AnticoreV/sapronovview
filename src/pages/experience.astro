---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import ExperienceItem from "@components/experience/ExperienceItem.astro";
import RecordRow from "@components/experience/RecordRow.astro";
import MilestoneList from "@components/experience/MilestoneList.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import { getMilestones, getPositions, milestoneLabels } from "@lib/content";
import { cvPath } from "@lib/cv";
import { siteConfig } from "@config";

const [positions, milestones] = await Promise.all([getPositions(), getMilestones()]);
const types = Object.keys(milestoneLabels) as Array<keyof typeof milestoneLabels>;
const byType = (t: (typeof types)[number]) => milestones.filter((m) => m.data.type === t);
---

<BaseLayout
  title="Experience"
  description={`Track record of ${siteConfig.name}: every position since 2021 with what I built and what changed because of it — JVM services, Angular products, identity, Kafka, Kubernetes and cloud.`}
>
  <div class="band pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: "Experience" }]} />
      <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="label text-ink-muted">Experience · since 2021</p>
          <h1 class="display mt-3 text-display-l">Track record</h1>
        </div>
        {cvPath ? (
          <a href={cvPath} class="btn btn-primary" download>
            Download CV
          </a>
        ) : (
          <a href="/contact?topic=hiring" class="btn btn-primary">
            CV on request
          </a>
        )}
      </div>
      <p class="mt-5 max-w-[640px] text-body-l">
        Where I've worked, what I owned and what changed because of it — from a freelance CRM in
        2021 to Kotlin microservices and a platform serving around two million users.
      </p>
    </div>
  </div>

  <section class="band mt-10" aria-label="Track record summary">
    <div class="shell flex flex-col">
      <div
        class="label grid grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] gap-x-6 gap-y-1 border-t border-b border-t-ink border-b-line py-3 text-ink-muted max-[640px]:hidden"
        aria-hidden="true"
      >
        <span>Years</span>
        <span>Company</span>
        <span>Role</span>
        <span>Shipped</span>
      </div>
      <ol class="max-[640px]:border-t max-[640px]:border-ink">
        {positions.map((p) => (
          <li>
            <RecordRow position={p} href={`#${p.id}`} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band section-gap pt-14" aria-labelledby="positions-heading">
    <div class="shell sheet px-[clamp(16px,5vw,64px)] py-10 md:py-14">
      <h2
        id="positions-heading"
        class="display text-[clamp(28px,3vw,40px)] leading-[1.05] tracking-[-0.03em]"
      >
        Positions
      </h2>
      <ol class="mt-8 flex flex-col divide-y divide-line">
        {positions.map((position) => (
          <li class="py-10 first:pt-0 last:pb-0">
            <ExperienceItem position={position} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  {milestones.length > 0 && (
    <section class="band section-gap" aria-labelledby="milestones-heading">
      <div class="shell flex flex-col gap-6">
        <SectionHeader id="milestones-heading" title="Education, credentials & community" />
        <div class="grid gap-4 md:grid-cols-2">
          {types.map((t) => (
            <MilestoneList type={t} items={byType(t)} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
