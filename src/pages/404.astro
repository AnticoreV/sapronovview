---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
---

<BaseLayout title="Page not found" description="That page doesn't exist." noindex>
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Off the map.</h1>
    <p class="text-fg-muted mt-4 max-w-md text-lg">
      This page doesn't exist — or it moved without filing a flight plan.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/" arrow>
        Back home
      </Button>
      <Button href="/projects" variant="secondary">
        Browse projects
      </Button>
    </div>
  </div>
</BaseLayout>
