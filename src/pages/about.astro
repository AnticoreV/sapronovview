---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import ProfileCard from "@components/profile/ProfileCard.astro";
import JsonLd from "@components/seo/JsonLd.astro";
import { shownAll } from "@lib/content";
import { personSchema } from "@lib/schema";
import { enjoys, facts, philosophy, values } from "@data/about";
import { siteConfig, techStack } from "@config";

const realFacts = shownAll(facts, (f) => f.text);
const site = Astro.site ?? new URL("http://localhost:4321");
// ProfilePage whose main entity is the same Person (#person) as on the homepage.
const profileLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: new URL("/about", site).toString(),
  name: `About ${siteConfig.name}`,
  mainEntity: personSchema(site),
};
---

<BaseLayout
  title="About"
  description={`Who ${siteConfig.name} is: backend & fullstack engineer and founder in Prague — career story, how I work, what I value and the languages I speak.`}
  type="profile"
>
  <div class="band pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: "About" }]} />
      <p class="label mt-8 text-ink-muted">About</p>
      <h1 class="display mt-3 max-w-[16ch] text-display-l">Engineer and founder.</h1>
    </div>
  </div>

  <section class="band section-gap pt-8" aria-labelledby="story-heading">
    <div class="shell grid items-start gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-12">
      <ProfileCard switcher eager initial="turtleneck" heading={false} />
      <div class="flex flex-col gap-4 text-body">
        <h2 id="story-heading" class="label text-ink-muted">
          Career story
        </h2>
        <p class="text-body-l">
          I'm {siteConfig.name}, a backend and fullstack engineer based in Prague with about five
          years of building and scaling enterprise web applications and services. Most of my time is
          on the JVM — Java and Kotlin, Spring — and on the Angular frontends, cloud infrastructure
          and identity systems that real products are made of.
        </p>
        <p>
          I started freelancing in Java in 2021, building a CRM with an admin panel and the
          analytics services behind its React dashboards. At Ableneo the problems got more
          distributed: Redis caching and reactive services with Spring WebFlux, Keycloak for SSO and
          CIAM, Kafka with custom connectors, Dockerised services on Kubernetes, and Grafana,
          Prometheus and InfluxDB to watch it all in production.
        </p>
        <p>
          At CCA Group I owned both sides of the stack — a dynamic form engine in Angular that cut
          the time to create new form types from days to hours, and the Java services behind it,
          some of which I moved to Kotlin coroutines to roughly halve p95 latency under peak load.
          At NCR Voyix I designed backend-for-frontend and aggregator services for a system serving
          around two million users, built a self-service Angular platform for US clients, ran
          services on GCP with full observability, and started using LLM and agentic tooling to take
          the routine out of engineering work.
        </p>
        <p>
          Most recently I spent three months at CreativeDock building Kotlin/Spring Boot
          microservices from scratch and fixing the GitLab CI and Argo CD plumbing around them.
          Right now I'm building{" "}
          <a href="/projects/ownira" class="link-inline font-semibold text-accent">
            Ownira
          </a>
          , now in pilot.
        </p>
        <p>
          The rest of my time goes to things with engines and horizons: I am a pilot in training on
          ultralight aircraft, I ride motorcycles, and I keep a growing list of countries. Flying
          rewards preparation and checklists, riding rewards attention, travel rewards curiosity —
          the same traits I try to bring to a codebase.
        </p>
      </div>
    </div>
  </section>

  <section class="band section-gap" aria-labelledby="philosophy-heading" data-reveal>
    <div class="shell flex flex-col gap-9">
      <SectionHeader id="philosophy-heading" title="How I work" />
      <ol class="grid gap-4 sm:grid-cols-2">
        {philosophy.map((p, i) => (
          <li class="card flex flex-col gap-3 p-7">
            <span class="mono text-[12px] font-semibold tracking-[0.06em] text-ink-muted">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="text-heading">{p.title}</h3>
            <p class="text-ink-muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band section-gap" aria-label="Values, languages and focus" data-reveal>
    <div class="shell grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="display text-[clamp(28px,3vw,40px)] leading-[1.05] tracking-[-0.03em]">
          What I value
        </h2>
        <dl class="mt-6 divide-y divide-line border-y border-line">
          {values.map((v) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[170px_1fr] sm:gap-6">
              <dt class="label pt-0.5 font-semibold">{v.label}</dt>
              <dd class="text-ink-muted">{v.text}</dd>
            </div>
          ))}
        </dl>
        <h2 class="label mt-10 text-ink-muted">Languages</h2>
        <ul class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-3">
          {siteConfig.languages.map((l) => (
            <li class="card px-4 py-3">
              <span class="mono block text-[12px] font-medium tracking-[0.04em] text-ink-muted uppercase">
                {l.code} · {l.level}
              </span>
              <span class="mt-1 block font-semibold">{l.name}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="display text-[clamp(28px,3vw,40px)] leading-[1.05] tracking-[-0.03em]">
          What I enjoy working on
        </h2>
        <ul class="mt-6 flex flex-col">
          {enjoys.map((e) => (
            <li class="flex gap-3 border-b border-line py-3">
              <span class="mono text-ok-ink" aria-hidden="true">
                ✓
              </span>
              <span>{e}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band section-gap" aria-labelledby="stack-heading" data-reveal>
    <div class="shell card p-7 sm:p-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2
          id="stack-heading"
          class="display text-[clamp(28px,3vw,40px)] leading-[1.05] tracking-[-0.03em]"
        >
          Stack I ship with
        </h2>
      </div>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {techStack.map((g) => (
          <div>
            <h3 class="label font-semibold text-accent">{g.group}</h3>
            <p class="mt-2 text-ink-muted">{g.items.join(" · ")}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {realFacts.length > 0 && (
    <section class="band section-gap" aria-labelledby="facts-heading">
      <div class="shell">
        <h2
          id="facts-heading"
          class="display text-[clamp(28px,3vw,40px)] leading-[1.05] tracking-[-0.03em]"
        >
          Facts
        </h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {realFacts.map((f) => (
            <li class="card p-5">{f.text}</li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <JsonLd data={profileLd} />
</BaseLayout>
