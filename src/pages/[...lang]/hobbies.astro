---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import HobbyModule from "@components/hobbies/HobbyModule.astro";
import { getHobbies } from "@lib/content";
import { visitedCountryCount as countries } from "@data/adventures";
import { i18n, localeParams } from "@/i18n";

export const getStaticPaths = localeParams;

const { locale, t, l } = i18n(Astro);
const hobbies = await getHobbies(locale);
---

<BaseLayout title={t("hobbies.title")} description={t("hobbies.description")}>
  <div class="band pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: t("hobbies.title") }]} />
      <h1 class="display mt-8 text-display-l">{t("hobbies.h1")}</h1>
      <p class="mt-5 max-w-[640px] text-body-l">{t("hobbies.intro")}</p>
      <nav aria-label={t("hobbies.jump")} class="mt-8 flex flex-wrap gap-2">
        {hobbies.map((h) => (
          <a href={`#${h.id}`} class="chip">
            {h.data.title}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="band pt-10 pb-4 md:pt-12">
    <div class="shell grid gap-4 lg:grid-cols-2">
      {hobbies.map((hobby, i) => (
        <HobbyModule hobby={hobby} index={i} />
      ))}
    </div>
  </div>

  <section class="band section-gap pt-8" aria-labelledby="map-teaser">
    <a
      href={l("/adventures")}
      class="teaser shell card lift flex flex-wrap items-center justify-between gap-6 p-7 no-underline sm:p-8"
    >
      <span class="flex flex-col gap-2">
        <span class="label text-ink-muted">{t("hobbies.teaser")}</span>
        <span
          id="map-teaser"
          class="display text-[clamp(28px,3vw,40px)] leading-none tracking-[-0.03em]"
        >
          {t("hobbies.mapLine", { countries: t("countries", { n: countries }) })}
        </span>
        <span class="text-ink-muted">{t("hobbies.teaserText")}</span>
      </span>
      <span class="btn btn-primary">{t("hobbies.openGlobe")}</span>
    </a>
  </section>
</BaseLayout>

<style>
  .teaser:hover {
    color: var(--ink);
  }
</style>
