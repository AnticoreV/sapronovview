---
/**
 * Homepage, restructured 2026-11-04 for recruiters and clients: hero (role, lede, three
 * ways in, facts at a glance, the live "Blueprint") → what I do → tech stack →
 * experience → selected projects → (my own product: Ownira, a side venture, only when
 * siteConfig.homeSections.ownProduct is on; off by default) → about me (with off duty) →
 * (writing) → contact panel (from BaseLayout).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/home/Hero.astro";
import Expertise from "@components/home/Expertise.astro";
import TechStack from "@components/home/TechStack.astro";
import ExperienceTimeline from "@components/home/ExperienceTimeline.astro";
import SelectedProjects from "@components/home/SelectedProjects.astro";
import Venture from "@components/home/Venture.astro";
import AboutMe from "@components/home/AboutMe.astro";
import Writing from "@components/home/Writing.astro";
import { getPositions, getPosts, getProjects } from "@lib/content";
import { visitedCountryCount } from "@data/adventures";
import { siteConfig, siteCopy } from "@config";
import { i18n, localeParams } from "@/i18n";

export const getStaticPaths = localeParams;

const { locale } = i18n(Astro);
const copy = siteCopy[locale];
const [projects, positions, posts] = await Promise.all([
  getProjects(locale),
  getPositions(locale),
  getPosts(),
]);
const products = projects.filter((p) => p.data.tagline);
---

<BaseLayout
  title={`${siteConfig.name} · ${copy.title}`}
  titleTemplate={false}
  description={copy.description}
  type="profile"
>
  <Hero />
  <Expertise />
  <TechStack />
  <ExperienceTimeline positions={positions} />
  <SelectedProjects projects={projects} />
  {siteConfig.homeSections.ownProduct && <Venture products={products} />}
  <AboutMe countries={visitedCountryCount} />
  <Writing posts={posts.slice(0, 3)} />
</BaseLayout>
