---
import ProjectLayout from "@layouts/ProjectLayout.astro";
import { bodyLang, getProjects, renderEntry } from "@lib/content";
import { i18n, locales } from "@/i18n";

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const projects = await getProjects(locale);
    for (const project of projects) {
      paths.push({
        params: { lang: locale === "en" ? undefined : locale, slug: project.id },
        props: {
          project,
          related: projects
            .filter(
              (p) =>
                p.id !== project.id &&
                (p.data.category === project.data.category || p.data.featured),
            )
            .slice(0, 3),
        },
      });
    }
  }
  return paths;
}

const { project, related } = Astro.props;
const { locale } = i18n(Astro);
const { Content } = await renderEntry(project);
---

<ProjectLayout project={project} related={related} bodyLang={bodyLang(project, locale)}>
  <Content />
</ProjectLayout>
