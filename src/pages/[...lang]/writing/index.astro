---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import ArticleRow from "@components/writing/ArticleRow.astro";
import TagList from "@components/writing/TagList.astro";
import { getAllTags, getPosts } from "@lib/content";
import { i18n, localeParams } from "@/i18n";

export const getStaticPaths = localeParams;

const { t } = i18n(Astro);
const posts = await getPosts();
const tags = await getAllTags(posts);
---

<BaseLayout
  title={t("writing.title")}
  description={t("writing.description")}
  noindex={posts.length === 0}
>
  <div class="band section-gap pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: t("writing.title") }]} />
      <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="label text-ink-muted">{t("writing.eyebrow")}</p>
          <h1 class="display mt-3 text-display-l">{t("writing.title")}</h1>
        </div>
        {posts.length > 0 && (
          <a href="/rss.xml" class="link-more">
            {t("writing.rss")}
          </a>
        )}
      </div>
      <p class="mt-5 max-w-[640px] text-body-l">{t("writing.intro")}</p>
      <TagList tags={tags} class="mt-8" />
      {posts.length > 0 ? (
        <ul class="mt-10 flex flex-col gap-3">
          {posts.map((post) => (
            <li>
              <ArticleRow post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="card mt-10 max-w-[720px] p-6">
          <p class="label text-ink">{t("writing.empty")}</p>
          <p class="mt-2 text-ink-muted">{t("writing.emptyText")}</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
