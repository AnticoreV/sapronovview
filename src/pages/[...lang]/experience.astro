---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import ExperienceItem from "@components/experience/ExperienceItem.astro";
import RecordRow from "@components/experience/RecordRow.astro";
import MilestoneList from "@components/experience/MilestoneList.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import { getMilestones, getPositions, milestoneLabels } from "@lib/content";
import { cvPath } from "@lib/cv";
import { siteConfig } from "@config";
import { i18n, localeParams } from "@/i18n";

export const getStaticPaths = localeParams;

const { locale, t, l } = i18n(Astro);
const [positions, milestones] = await Promise.all([getPositions(locale), getMilestones()]);
const types = Object.keys(milestoneLabels.en) as Array<keyof typeof milestoneLabels.en>;
const byType = (t: (typeof types)[number]) => milestones.filter((m) => m.data.type === t);
---

<BaseLayout
  title={t("experience.title")}
  description={t("experience.description", { name: siteConfig.name })}
>
  <div class="band pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: t("experience.title") }]} />
      <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
        <h1 class="display text-display-l">{t("record.title")}</h1>
        {cvPath ? (
          <a href={cvPath} class="btn btn-primary" download>
            {t("record.cvDownload")}
          </a>
        ) : (
          <a href={l("/contact?topic=hiring")} class="btn btn-primary">
            {t("record.cvRequest")}
          </a>
        )}
      </div>
      <p class="mt-5 max-w-[640px] text-body-l">{t("experience.intro")}</p>
    </div>
  </div>

  <section class="band mt-10" aria-label={t("experience.summary")}>
    <div class="shell flex flex-col">
      <div
        class="label grid grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] gap-x-6 gap-y-1 border-t border-b border-t-ink border-b-line py-3 text-ink-muted max-[640px]:hidden"
        aria-hidden="true"
      >
        <span>{t("record.years")}</span>
        <span>{t("record.company")}</span>
        <span>{t("record.role")}</span>
        <span>{t("record.shipped")}</span>
      </div>
      <ol class="max-[640px]:border-t max-[640px]:border-ink">
        {positions.map((p) => (
          <li>
            <RecordRow position={p} href={`#${p.id}`} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band section-gap pt-20" aria-labelledby="positions-heading">
    <div class="shell flex flex-col gap-2">
      <SectionHeader id="positions-heading" title={t("experience.positions")} />
      <ol class="flex flex-col divide-y divide-line">
        {positions.map((position) => (
          <li class="py-10 last:pb-0">
            <ExperienceItem position={position} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  {milestones.length > 0 && (
    <section class="band section-gap" aria-labelledby="milestones-heading">
      <div class="shell flex flex-col gap-6">
        <SectionHeader id="milestones-heading" title={t("experience.milestones")} />
        <div class="grid gap-4 md:grid-cols-2">
          {types.map((type) => (
            <MilestoneList type={type} items={byType(type)} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
