---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import FormattedDate from "@components/ui/FormattedDate.astro";
import { bodyLang, getNow, getProjects, renderEntry, shown, shownAll } from "@lib/content";
import { i18n, localeParams } from "@/i18n";

export const getStaticPaths = localeParams;

const { locale, t, l } = i18n(Astro);
const entry = await getNow(locale);
const { Content } = await renderEntry(entry);
const lang = bodyLang(entry, locale);
const { data } = entry;
const projects = await getProjects(locale);
const sideProjects = data.sideProjects
  .map((ref) => projects.find((p) => p.id === ref.id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const working = shownAll(data.working);
const learning = shownAll(data.learning);
const reading = shownAll(data.reading, (r) => `${r.title} ${r.author ?? ""} ${r.note ?? ""}`);
const interests = shownAll(data.interests);
const groups = [
  { id: "working", title: t("now.working"), items: working },
  { id: "learning", title: t("now.learning"), items: learning },
].filter((g) => g.items.length > 0);
---

<BaseLayout title={t("now.title")} description={t("now.description")} type="profile">
  <div class="band section-gap pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: t("now.title") }]} />
    </div>
    <article class="sheet mx-auto mt-6 max-w-[848px] px-[clamp(16px,6vw,64px)] py-10 md:py-16">
      <p class="label flex flex-wrap gap-x-2 text-ink-muted">
        <span>{t("now.title")}</span>
        <span aria-hidden="true">·</span>
        <span>
          {t("now.updated", { date: "" }).trim()}{" "}
          <FormattedDate
            date={data.updated}
            format={{ year: "numeric", month: "short", day: "numeric" }}
          />
        </span>
        {shown(data.location) && (
          <>
            <span aria-hidden="true">·</span>
            <span>{data.location}</span>
          </>
        )}
      </p>
      <h1 class="display mt-4 text-[clamp(36px,5vw,56px)] leading-[1] tracking-[-0.04em]">
        {t("now.h1")}
      </h1>
      <div class="prose-sheet mt-6 text-body-l" lang={lang === locale ? undefined : lang}>
        <Content />
      </div>

      <div class="mt-10 flex flex-col gap-8">
        {groups.map((g) => (
          <section aria-labelledby={`now-${g.id}`}>
            <h2 id={`now-${g.id}`} class="label text-ink-muted">
              {g.title}
            </h2>
            <ul class="mt-3 flex list-disc flex-col gap-2 pl-5 marker:text-line-strong">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))}
        {reading.length > 0 && (
          <section aria-labelledby="now-reading">
            <h2 id="now-reading" class="label text-ink-muted">
              {t("now.reading")}
            </h2>
            <ul class="mt-3 flex flex-col gap-3">
              {reading.map((r) => (
                <li>
                  <p class="font-semibold">{r.title}</p>
                  {r.author && <p class="text-small text-ink-muted">{r.author}</p>}
                  {r.note && <p class="mt-1 text-small text-ink-muted">{r.note}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
        {sideProjects.length > 0 && (
          <section aria-labelledby="now-projects">
            <h2 id="now-projects" class="label text-ink-muted">
              {t("now.projects")}
            </h2>
            <ul class="mt-3 flex flex-col gap-3">
              {sideProjects.map((p) => (
                <li>
                  <a href={l(`/projects/${p.id}`)} class="link-inline font-semibold text-accent">
                    {p.data.title}
                  </a>
                  <p class="text-small text-ink-muted">{p.data.description}</p>
                </li>
              ))}
            </ul>
          </section>
        )}
        {interests.length > 0 && (
          <section aria-labelledby="now-interests">
            <h2 id="now-interests" class="label text-ink-muted">
              {t("now.interests")}
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {interests.map((i) => (
                <li class="chip">{i}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </article>
  </div>
</BaseLayout>
