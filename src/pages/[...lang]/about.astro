---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import ProfileCard from "@components/profile/ProfileCard.astro";
import JsonLd from "@components/seo/JsonLd.astro";
import { shownAll } from "@lib/content";
import { personSchema } from "@lib/schema";
import { aboutCopy } from "@data/about";
import { siteConfig, siteCopy } from "@config";
import { stack, stackItem } from "@data/stack";
import { i18n, localeParams } from "@/i18n";
import { localeTags } from "@/i18n/locales";

export const getStaticPaths = localeParams;

const { locale, t, l } = i18n(Astro);
const { story, philosophy, enjoys, values, facts } = aboutCopy(locale);
const [lead, ...paragraphs] = story;
const realFacts = shownAll(facts, (f) => f.text);
const site = Astro.site ?? new URL("http://localhost:4321");
// ProfilePage whose main entity is the same Person (#person) as on the homepage.
const profileLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: new URL(l("/about"), site).toString(),
  name: `${t("about.title")} · ${siteConfig.name}`,
  inLanguage: localeTags[locale],
  mainEntity: personSchema(site),
};
---

<BaseLayout
  title={t("about.title")}
  description={t("about.description", { name: siteConfig.name })}
  type="profile"
>
  <div class="band pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: t("about.title") }]} />
      <h1 class="display mt-8 max-w-[16ch] text-display-l">{t("who.heading")}</h1>
    </div>
  </div>

  <section class="band section-gap pt-8" aria-labelledby="story-heading">
    <div class="shell grid items-start gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-12">
      <ProfileCard switcher eager initial="turtleneck" heading={false} />
      <div class="flex flex-col gap-4 text-body">
        <h2 id="story-heading" class="label text-ink-muted">
          {t("about.story")}
        </h2>
        <p class="text-body-l">{lead}</p>
        {paragraphs.map((text) => {
          const [before, after] = text.split("{ownira}");
          return after === undefined ? (
            <p>{text}</p>
          ) : (
            <p>
              {before}
              <a href={l("/projects/ownira")} class="link-inline font-semibold text-accent">
                Ownira
              </a>
              {after}
            </p>
          );
        })}
      </div>
    </div>
  </section>

  <section class="band section-gap" aria-labelledby="philosophy-heading">
    <div class="shell flex flex-col gap-9">
      <SectionHeader id="philosophy-heading" title={t("about.how")} />
      <ol class="grid gap-4 sm:grid-cols-2">
        {philosophy.map((p) => (
          <li class="card flex flex-col gap-3 p-7">
            <h3 class="text-heading">{p.title}</h3>
            <p class="text-ink-muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band section-gap" aria-label={t("about.valuesLabel")}>
    <div class="shell grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="display text-display-s">{t("about.value")}</h2>
        <dl class="mt-6 divide-y divide-line border-y border-line">
          {values.map((v) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[170px_1fr] sm:gap-6">
              <dt class="label pt-0.5 font-semibold">{v.label}</dt>
              <dd class="text-ink-muted">{v.text}</dd>
            </div>
          ))}
        </dl>
        <h2 class="label mt-10 text-ink-muted">{t("about.languages")}</h2>
        <ul class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-3">
          {siteCopy[locale].languages.map((lang) => (
            <li class="card px-4 py-3">
              <span class="mono block text-[12px] font-medium text-ink-muted">
                {lang.code} · {lang.level}
              </span>
              <span class="mt-1 block font-semibold">{lang.name}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="display text-display-s">{t("about.enjoy")}</h2>
        <ul class="mt-6 flex flex-col">
          {enjoys.map((e) => (
            <li class="border-b border-line py-3">{e}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band section-gap" aria-labelledby="stack-heading">
    <div class="shell card p-7 sm:p-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="stack-heading" class="display text-display-s">
          {t("about.stack")}
        </h2>
      </div>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {stack.map((g) => (
          <div>
            <h3 class="label font-semibold text-accent">{g.label[locale]}</h3>
            <p class="mt-2 text-ink-muted">
              {[...g.core, ...g.also].map((item) => stackItem(item, locale)).join(" · ")}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {realFacts.length > 0 && (
    <section class="band section-gap" aria-labelledby="facts-heading">
      <div class="shell">
        <h2 id="facts-heading" class="display text-display-s">
          {t("about.facts")}
        </h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {realFacts.map((f) => (
            <li class="card p-5">{f.text}</li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <JsonLd data={profileLd} />
</BaseLayout>
