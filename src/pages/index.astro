---
/**
 * Homepage — the approved D4 · Pre-flight artboard (PreflightDesktop.dc.html):
 * hero with the live 3D panel → crew card + checklist → products → systems →
 * case studies → logbook → writing + off duty → contact (from BaseLayout).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/home/Hero.astro";
import CrewRow from "@components/home/CrewRow.astro";
import Products from "@components/home/Products.astro";
import Systems from "@components/home/Systems.astro";
import Cases from "@components/home/Cases.astro";
import Logbook from "@components/home/Logbook.astro";
import WritingOffDuty from "@components/home/WritingOffDuty.astro";
import { getPositions, getPosts, getProjects } from "@lib/content";
import { adventures } from "@data/adventures";
import { siteConfig } from "@config";

const [projects, positions, posts] = await Promise.all([getProjects(), getPositions(), getPosts()]);
const products = projects.filter((p) => p.data.tagline);
const countries = new Set(
  adventures.filter((a) => a.status === "visited").map((a) => a.countryCode),
).size;
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.title}`}
  titleTemplate={false}
  description={siteConfig.description}
  type="profile"
>
  <Hero />
  <CrewRow />
  <Products products={products} />
  <Systems />
  <Cases projects={projects} />
  <Logbook positions={positions} />
  <WritingOffDuty posts={posts.slice(0, 3)} countries={countries} />
</BaseLayout>
