---
/**
 * Homepage — the approved design v2 artboards (screens/RuntimeDesktop.dc.html with the
 * hero from screens/HeroV6.dc.html): hero with the live "Blueprint" → proof numbers
 * → who I am + contents → what I'm building → what I can do → proof in production →
 * track record → (writing) + off duty → contact panel (from BaseLayout).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/home/Hero.astro";
import Proof from "@components/home/Proof.astro";
import WhoIAm from "@components/home/WhoIAm.astro";
import Products from "@components/home/Products.astro";
import Capabilities from "@components/home/Capabilities.astro";
import Cases from "@components/home/Cases.astro";
import TrackRecord from "@components/home/TrackRecord.astro";
import OffDuty from "@components/home/OffDuty.astro";
import { getPositions, getPosts, getProjects } from "@lib/content";
import { visitedCountryCount } from "@data/adventures";
import { siteConfig } from "@config";

const [projects, positions, posts] = await Promise.all([getProjects(), getPositions(), getPosts()]);
const products = projects.filter((p) => p.data.tagline);
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.title}`}
  titleTemplate={false}
  description={siteConfig.description}
  type="profile"
  contactIndex="05"
>
  <Hero />
  <Proof />
  <WhoIAm />
  <Products products={products} />
  <Capabilities />
  <Cases projects={projects} />
  <TrackRecord positions={positions} />
  <OffDuty posts={posts.slice(0, 3)} countries={visitedCountryCount} />
</BaseLayout>
