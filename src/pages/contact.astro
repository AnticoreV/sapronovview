---
/**
 * /contact on the night panel: routes (as emails with the subject filled in),
 * the email address as the primary action, and the form with honest states.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import ContactForm from "@components/contact/ContactForm.astro";
import ContactRoute from "@components/contact/ContactRoute.astro";
import CopyEmail from "@components/ui/CopyEmail.astro";
import { siteConfig } from "@config";
import { contactRoutes, mailtoFor } from "@data/contact";

const connected = /^https:\/\/formspree\.io\/f\/[A-Za-z0-9]+$/.test(siteConfig.formAction);
---

<BaseLayout
  title="Contact"
  description={`Contact ${siteConfig.name} about a senior backend or fullstack role, Ownira and Apexline, or building, automating and shipping together.`}
  contactBlock={false}
>
  <div class="night bg-panel text-ink">
    <section class="band section-y" aria-labelledby="contact-heading">
      <div class="shell flex flex-col gap-11">
        <Breadcrumbs items={[{ label: "Contact" }]} />
        <h1
          id="contact-heading"
          class="display text-[clamp(3rem,7.4vw,7.25rem)] leading-[0.88] tracking-[-0.02em]"
        >
          Cleared for
          <br />
          <span class="text-select">your project.</span>
        </h1>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={`mailto:${siteConfig.email}`}
            class="btn btn-primary min-h-[54px] max-w-full px-7"
          >
            <span class="truncate">{siteConfig.email}</span>
          </a>
          <CopyEmail />
          {siteConfig.social.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              class="link-inline inline-flex min-h-11 items-center"
              rel="me"
            >
              LinkedIn
            </a>
          )}
          {siteConfig.social.github && (
            <a
              href={siteConfig.social.github}
              class="link-inline inline-flex min-h-11 items-center"
              rel="me"
            >
              GitHub
            </a>
          )}
        </div>
        <p class="max-w-[640px] text-body-l text-ink-muted">
          Email is the fastest way to reach me. Pick a route and the subject line is filled in for
          you.
        </p>
        <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
          {contactRoutes.map((route) => (
            <li class="flex">
              <ContactRoute
                route={route}
                href={mailtoFor(siteConfig.email, route.subject)}
                level={2}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band pb-16 md:pb-24" aria-label="Contact form">
      <div class="shell grid items-start gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
        <ContactForm />
        <section
          class="flex flex-col gap-3 text-small text-ink-muted"
          aria-labelledby="privacy-heading"
        >
          <h2 id="privacy-heading" class="label text-ink">
            Privacy
          </h2>
          {connected ? (
            <p>
              The form sends your name, email, topic and message to Formspree (formspree.io), which
              processes them on my behalf and forwards them to my inbox. I use them only to reply to
              you.
            </p>
          ) : (
            <p>
              While the form is not connected, nothing is sent from this page — your text only goes
              wherever your own email app sends it.
            </p>
          )}
          <p>
            This site sets no cookies and runs no analytics. Your day / night panel choice is kept
            in your browser's local storage and never leaves it.
          </p>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>
