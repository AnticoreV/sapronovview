---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import CodeRow from "@components/projects/CodeRow.astro";
import InstrumentModule from "@components/projects/InstrumentModule.astro";
import ProjectFilters from "@components/projects/ProjectFilters.astro";
import ProjectRow from "@components/projects/ProjectRow.astro";
import { getCodeProjects, getProjects } from "@lib/content";

const [all, code] = await Promise.all([getProjects(), getCodeProjects()]);
// Entries still marked placeholder only appear as repository rows (also in dev).
const projects = all.filter((p) => !p.data.placeholder);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<BaseLayout
  title="Projects"
  description="Own products and client systems — Ownira, Apexline, a self-service menu platform, a dynamic form engine and greenfield Kotlin services — each written up as a case study, plus code on GitHub."
>
  <div class="band pt-8 md:pt-10">
    <div class="shell">
      <Breadcrumbs items={[{ label: "Projects" }]} />
      <p class="label mt-8 text-ink-muted">Products · client work · case studies</p>
      <h1 class="display mt-3 text-display-l">Projects</h1>
      <p class="mt-5 max-w-[640px] text-body-l">
        Own products and the client systems I built — each written up as a case study, with only the
        numbers that are real.
      </p>
      <div class="mt-8">
        <ProjectFilters projects={[...projects, ...code]} />
      </div>
    </div>
  </div>

  <section class="band pt-8 pb-16 md:pb-24" aria-labelledby="featured-heading" data-project-group>
    <div class="shell">
      <h2 id="featured-heading" class="sr-only">
        Featured projects
      </h2>
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] gap-4">
        {featured.map((p, i) => (
          <li class="flex" data-category={p.data.category}>
            <InstrumentModule project={p} level={2} size={i < 2 && p.data.tagline ? "lg" : "md"} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {rest.length > 0 && (
    <section class="band pb-16 md:pb-24" aria-labelledby="archive-heading" data-project-group>
      <div class="shell sheet px-[clamp(20px,4vw,56px)] py-10">
        <h2 id="archive-heading" class="display text-[clamp(1.75rem,3vw,2.5rem)]">
          Archive
        </h2>
        <ul class="mt-6 border-t-2 border-ink">
          {rest.map((p) => (
            <li data-category={p.data.category}>
              <ProjectRow project={p} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {code.length > 0 && (
    <section class="band pb-16 md:pb-24" aria-labelledby="code-heading" data-project-group>
      <div class="shell sheet px-[clamp(20px,4vw,56px)] py-10">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="code-heading" class="display text-[clamp(1.75rem,3vw,2.5rem)]">
            Code on GitHub
          </h2>
          <span class="label text-ink-muted">Public repositories</span>
        </div>
        <ul class="mt-6 border-t-2 border-ink">
          {code.map((p) => (
            <li data-category={p.data.category}>
              <CodeRow project={p} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
